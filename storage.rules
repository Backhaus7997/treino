rules_version = '2';

// Firebase Storage security rules for TREINO.
// Admin SDK in Cloud Functions bypasses these entirely (ADR-ACCDEL-013).
service firebase.storage {
  match /b/{bucket}/o {
    // Avatars: any image extension owned by the authenticated user.
    // Path pattern: /avatars/{uid}.{ext}  e.g. avatars/abc123.jpg, avatars/abc123.heic
    //
    // `get` es amplio a propósito: el avatar se muestra en feed, chat, reviews
    // y rankings a cualquier autenticado, y la misma imagen ya viaja por
    // `userPublicProfiles/{uid}.avatarUrl`, que es world-readable a la misma
    // audiencia (`firestore.rules:780`). No expone nada nuevo.
    //
    // `list` va cerrado (QA-SEC-007): el nombre del archivo **ES el uid**, así
    // que enumerar el prefijo no devolvía "unas fotos" sino el padrón de uids
    // que alguna vez subieron avatar, en una sola llamada. Los uids ya son
    // enumerables por `userPublicProfiles`, así que esto no era la primera
    // puerta — pero es una puerta **paralela**, sobre una población distinta
    // (los objetos que existen en el bucket) y que sobreviviría a cualquier
    // endurecimiento futuro de aquél. Cerrarlo es seguro: cero llamadas a
    // `listAll()` / `.list()` del SDK de Storage en todo `lib/`. Ver
    // `docs/security.md` §3.2.
    //
    // `delete` TIENE que ser una regla propia (QA-SEC-009): sin ella el
    // borrado cae en `write`, cuya condición dereferencia
    // `request.resource.size` y `.contentType` — y en un delete
    // `request.resource` es **null**. La evaluación explotaba con
    // "Null value error" y el borrado se denegaba **hasta para el dueño**,
    // que es la regla 3 de `docs/security.md` §3.8: toda regla con
    // `request.resource.<algo>` necesita su `allow delete` propio o el
    // borrado se rompe en silencio. El gate es el mismo `fileName.matches`
    // anclado al uid que usa el `write`, sin tocar `request.resource`.
    match /avatars/{fileName} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if request.auth != null
                  && fileName.matches(request.auth.uid + '\\..+')
                  && request.resource.size < 5 * 1024 * 1024
                  && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && fileName.matches(request.auth.uid + '\\..+');
    }

    // Excel imports — bloque CERRADO en las cuatro operaciones (QA-SEC-015).
    //
    // El comentario viejo decía "trainers upload Excel plan files under
    // /temp/uploads/{uid}/..." y era falso: **nunca hubo un writer en `lib/`**.
    // No es que se borró — `git log -S "temp/uploads" --all -- lib/` devuelve
    // cero commits. El bloque entró vestigial en el commit que trajo este
    // archivo desde el repo viejo (`75581f89`, #106), describiendo una
    // arquitectura server-side que en TREINO Flutter nunca se implementó.
    //
    // El import de planes por Excel es **100% client-side y en memoria**:
    // `FilePicker.pickFiles(withData: true)` → `file.bytes` →
    // `PlanImportRepository.parseAndMatch(bytes:)` → `parseExcelBytes()`. Los
    // bytes del .xlsx no salen del proceso; lo único que viaja a Firebase es
    // el `ParsedPlan` ya matcheado, como documentos de Firestore.
    //
    // Lo que el `write` abierto dejaba hacer, medido contra el emulador
    // (`docs/security.md` §4.9): cualquier autenticado —incluido un rol
    // `athlete`, que no tiene nada que hacer acá— subía bytes arbitrarios, de
    // cualquier tipo y cualquier tamaño, sin ciclo de vida. El prefijo se
    // llama `temp/` pero no había TTL ni job de limpieza: lo único que barre
    // `temp/uploads/{uid}/` es el cascade de borrado de cuenta
    // (`functions/src/cascade/storage.ts:67`), o sea que los bytes vivían
    // mientras viviera la cuenta.
    //
    // Se cierra el camino de escritura entero en vez de acotarlo con
    // content-type + cap como los otros cinco bloques. Acotar habría
    // preservado una superficie de escritura que ningún código usa; cerrar la
    // elimina, y de paso vuelve innecesaria la regla de ciclo de vida del
    // bucket que pedía #782 — sin escrituras no hay acumulación que expirar.
    // Si el import alguna vez se mueve a server-side, este bloque se reabre
    // con el flujo real a la vista, que es mejor que adivinar un cap hoy.
    //
    // `get` y `list` van por separado aunque los dos sean `if false`
    // (`docs/security.md` §3.8 regla 2): `read` a secas esconde que `list` es
    // un permiso distinto, y fue la causa raíz de QA-SEC-007 y -008.
    //
    // NO lleva `allow delete` propio: la regla 3 de §3.8 aplica a los bloques
    // que dereferencian `request.resource.<algo>` —ahí el delete explota con
    // "Null value error" y se deniega hasta para el dueño (QA-SEC-009)—. Acá
    // no queda ni un deref, así que el `write: if false` cubre el delete
    // denegando por permiso, que es la denegación que queremos. El cascade de
    // borrado de cuenta no se ve afectado: usa Admin SDK y bypasea estas
    // reglas por completo (ADR-ACCDEL-013).
    match /temp/uploads/{userId}/{file=**} {
      allow get: if false;
      allow list: if false;
      allow write: if false;
    }

    // Custom exercise tutorial videos: a trainer uploads short clips
    // (MP4 / MOV / M4V, max 100 MB) under /customExerciseVideos/{uid}/...
    // Only the owner can write or delete.
    //
    // `get` es amplio a propósito, pero NO por el reproductor: el comentario
    // que decía "so the trainer's athletes can play them inline" era falso y
    // se corrigió con QA-SEC-008. La URL `?alt=media&token=` que emite
    // `getDownloadURL()` es una credencial al portador y NO evalúa estas
    // reglas (medido: 200 sin auth, 403 sin token — `docs/security.md` §3.1);
    // la app siempre renderiza desde la URL persistida en
    // `users/{tid}/customExercises/{id}.videoUrl`, nunca reconstruye un
    // `ref()`. El `get` amplio se conserva porque es consistente con
    // `firestore.rules:1575` — el doc que referencia el video ya es legible
    // por cualquier autenticado, así que el contenido no es más secreto que
    // su referencia.
    //
    // `list` es otra cosa y va cerrado incondicionalmente (QA-SEC-008): el
    // INVENTARIO sí es secreto — no hay ningún doc de Firestore que lo
    // publique. Con `{file=**}` la enumeración era recursiva y alcanzaba dos
    // cosas que no existen en ninguna otra parte del producto: listar la raíz
    // devolvía el uid de cada PF con videos, y listar su carpeta devolvía la
    // videoteca entera, incluidos los huérfanos de ejercicios ya borrados del
    // catálogo. Cerrarlo es seguro: cero llamadas a `listAll()` / `.list()`
    // del SDK de Storage en todo `lib/` (lo único que enumera el bucket es
    // `functions/src/cascade/storage.ts`, con Admin SDK, que ignora estas
    // reglas — ADR-ACCDEL-013). Mismo patrón que `postPhotos` y `chatMedia`.
    match /customExerciseVideos/{userId}/{file=**} {
      // ── El tope de costo (#video-quota) ────────────────────────────────
      //
      // El bloque tenía cap de TAMAÑO por archivo y NINGUNO de CANTIDAD, y el
      // paywall del alumno no lo tocaba. Medido sobre el bucket de producción
      // el 2026-09-10: 3 objetos, 2,84 MB, de UN solo dueño, y ese dueño es un
      // PF. Ningún alumno subió jamás un video. O sea que esto NO se está
      // desangrando hoy — se cierra antes de que haya algo que recortar.
      //
      // Qué costaba dejarlo abierto: sin tope de cantidad el peor caso es
      // infinito, y el egress lo multiplica. Estos videos se sirven por la URL
      // `?alt=media&token=` de `getDownloadURL()` — GCS directo, sin CDN (ver
      // el comentario de `get` acá abajo y `docs/security.md` §3.1), así que
      // cada play es egress a USD 0,12/GB contra USD 0,026/GB-mes de guardarlo.
      // Por eso el cap POR ARCHIVO es la palanca principal: pega en las dos
      // líneas de costo, no en una.
      //
      // Los cuatro números viven en `athlete_entitlement.dart`
      // (`kFreeMaxCustomExerciseVideos`, `kFreeMaxCustomExerciseVideoBytes`,
      // `kMaxCustomExerciseVideos`, `kMaxCustomExerciseVideoBytes`) y están
      // duplicados A MANO acá, igual que `freeMaxRoutineDays()` en
      // `firestore.rules`. Si cambiás uno, cambiá el otro: si no, el cliente
      // muestra un tope y el servidor aplica otro.
      //
      // ── Por qué el conteo se lee y no se calcula ────────────────────────
      //
      // Las reglas de Storage NO tienen agregación: no pueden listar ni contar
      // objetos de un prefijo. Igual que con `athletePaywallEnforced`, la
      // conclusión se denormaliza en Firestore —acá en
      // `users/{uid}.customExerciseVideoUsage.count`, que escribe
      // `maintainCustomExerciseVideoQuota`— y la regla lee ese número.
      //
      // Ese contador VA ATRASADO por diseño: el trigger de Storage corre
      // DESPUÉS de que el objeto aterrizó. Un cliente que dispare N subidas en
      // paralelo las ve todas contra el mismo valor viejo y se pasa del tope
      // por el tamaño de la ráfaga. Por eso la CF además BORRA lo que sobra:
      // la regla es el gate preventivo que atrapa el 99,9% y la CF es la red
      // reactiva que cierra la carrera. Ninguna de las dos alcanza sola, y la
      // CF sola tampoco serviría — cuando corre, los bytes ya entraron.
      //
      // ── Fail-open, y hasta dónde ───────────────────────────────────────
      //
      // `firestore.get()` devuelve null si el doc no existe, y hay escrituras
      // legítimas de usuarios sin doc de perfil todavía (mismo caso que
      // documenta `paywallEnforcedFor` en `firestore.rules`). Sin doc ⇒ no
      // enforced, igual que allá. Pero el TECHO ESTRUCTURAL (100 MB, 50
      // videos) se aplica siempre, con doc o sin él: el fail-open afloja el
      // tope del paywall, nunca el del producto.
      //
      // Y el PF nunca cae en el tope free: `athletePaywallEnforced` sale de
      // `resolveAthletePaywallEnforced`, que arranca con
      // `if (userData?.role !== "athlete") return false`. Eso importa porque
      // este editor es superficie COMPARTIDA — lo abren el alumno
      // (`profile_screen.dart`, `exercise_picker_sheet.dart`) y el PF
      // (`trainer_profile_view.dart`, Coach Hub web). Gatear sobre el
      // entitlement del cliente en vez de sobre este campo le rompería la
      // videoteca a todos los PF, porque `athleteEntitlementProvider` SÍ
      // devuelve `free` para un PF (no mira `role`).
      // UNA sola función y UNA sola lectura de Firestore. Tres helpers
      // (tamaño, cantidad, tier) se leerían mejor pero serían tres
      // `firestore.get()` sobre el mismo path, y cada uno es una lectura
      // facturada — el mismo costo que `docs/paywall-alumno-suelto.md` §320
      // marca para los `get()` de las reglas.
      function videoWriteAllowed(userId) {
        let u = firestore.get(/databases/(default)/documents/users/$(userId));
        let d = u == null ? {} : u.data;
        let enforced = d.get('athletePaywallEnforced', false) == true;
        let usage = d.get('customExerciseVideoUsage', {});
        return request.resource.size
                 < (enforced ? 25 * 1024 * 1024 : 100 * 1024 * 1024)
               && usage.get('count', 0) < (enforced ? 3 : 50);
      }

      allow get: if request.auth != null;
      allow list: if false;
      allow write: if request.auth != null
                  && request.auth.uid == userId
                  && request.resource.contentType.matches('video/.*')
                  && videoWriteAllowed(userId);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Chat media — photos and videos sent inside 1-1 chats (REQ-CHATMEDIA-007).
    //
    // Path: /chatMedia/{chatId}/{userId}/{file}
    //
    // Membership gate (rules-hardening Slice A / AD-2): chatId is
    // deterministic (ChatRepository.chatIdFor = sorted([a,b]).join('_')) and
    // uids are enumerable (userPublicProfiles is world-readable), so a plain
    // `request.auth != null` read let any authenticated account reconstruct
    // and download/list another pair's private media. Storage rules CAN call
    // firestore.get() cross-service (the old in-file comment claiming
    // otherwise was outdated) — `get` is now gated by `chats/{chatId}.members`
    // membership, and `list` is closed unconditionally (Storage `list` cannot
    // be scoped per-object, so per-uid folder enumeration would still leak
    // other users' media paths even with the `get` gate in place).
    //
    // NOTE: the literal `(default)` database name is required here — Storage
    // rules have no `$(database)` wildcard (that binds from the Firestore
    // `match /databases/{database}/documents` header, which does not exist
    // in this rules file).
    //
    // Size limits: images < 15 MB, videos < 25 MB (free) / 50 MB (techo), y un
    // tope de BYTES TOTALES por usuario. Ver `chatMediaWriteAllowed()` abajo.
    match /chatMedia/{chatId}/{userId}/{file=**} {
      // Only members of this chat can download individual media objects.
      allow get: if request.auth != null
                 && request.auth.uid in
                    firestore.get(/databases/(default)/documents/chats/$(chatId)).data.members;

      // list is unconditionally closed — never expose the folder listing,
      // not even to members.
      allow list: if false;

      // ── El tope de costo (#chat-media-quota) ───────────────────────────
      //
      // Este bloque tenía cap de TAMAÑO por archivo y NINGUNO de total, y el
      // paywall del alumno no lo tocaba — el mismo agujero que se cerró en
      // `customExerciseVideos`, pero sobre el prefijo donde de verdad se
      // acumula el UGC. Medido el 2026-09-14 sobre `treino-dev`: 127,18 MB en
      // 15 objetos, **45x** los bytes de la videoteca. Y a diferencia de una
      // videoteca de tutoriales, que se arma una vez, el chat genera bytes de
      // forma CONTINUA. Ver `docs/costos-storage.md` §7.
      //
      // ── Por qué el eje es BYTES TOTALES y no cantidad ni «por chat» ─────
      //
      // No se puede copiar el tope de `customExerciseVideos`, y el motivo es
      // la forma del uso:
      //
      //   • Aquél es una BIBLIOTECA —pocos archivos, se arma una vez— así que
      //     `cantidad × por-archivo` acota el total.
      //   • El chat es un FLUJO. Un PF con 30 alumnos manda cientos de
      //     archivos por año legítimamente: el tope de cantidad tendría que
      //     ser enorme para no romperle el producto, y con la cantidad enorme
      //     ese producto deja de ser un techo útil. El total en bytes sí lo es.
      //
      // Y tampoco es «por chat», aunque sea la unidad que el path sugiere:
      // `firestore.rules` (~1973) tiene TRES ramas de creación de chat
      // —vínculo de Coach, social direccional (REQ-FOLLOW-012) e inquiry
      // (#637, cualquier atleta a cualquier PF publicado)— así que la cantidad
      // de chats por usuario NO tiene techo. N chats × tope-por-chat = sin
      // techo. Medido: de 17 chats, 10 son sociales, 3 inquiry y 4 de Coach, y
      // el chat que concentra el 94% de los bytes es SOCIAL, no de Coach.
      //
      // ── Los números ────────────────────────────────────────────────────
      //
      // El video baja de 100 MB a 50 (25 en free). El máximo observado del
      // bucket —un MP4 de 90,31 MB— es el **71% de todo el prefijo**, y el
      // segundo video más grande pesa 9,25 MB: un salto de 10x. Por eso acá el
      // múltiplo se saca contra el p90 real (9,12 MB) y no contra el máximo,
      // al revés que en `customExerciseVideos`, donde el máximo era un dato
      // sano. Bajar el techo a 50 rechaza EXACTAMENTE ese archivo y ninguno
      // más de los que existen.
      //
      // La imagen queda en 15 MB a propósito: el máximo observado es 4,98 MB y
      // las imágenes son el 10% de los bytes. No lleva variante free — el eje
      // del costo son los videos (89,8% de los bytes) y el tope de bytes
      // totales ya acota lo que las fotos acumulan.
      //
      // Los cinco números viven en `athlete_entitlement.dart`
      // (`kFreeMaxChatMediaBytes`, `kMaxChatMediaBytes`,
      // `kFreeMaxChatVideoBytes`, `kMaxChatVideoBytes`, `kMaxChatImageBytes`)
      // y están duplicados A MANO acá y en `chat-media-quota.ts`. Si cambiás
      // uno, cambiá los tres.
      //
      // ── El contador, y por qué va atrasado ─────────────────────────────
      //
      // Las reglas de Storage no tienen agregación: no pueden listar ni sumar
      // los bytes de un prefijo. La conclusión se denormaliza en
      // `users/{uid}.chatMediaUsage.bytes`, que escribe
      // `maintainChatMediaQuota*`, y la regla lee ese número — mismo patrón y
      // mismo motivo que `athletePaywallEnforced` y que el bloque
      // `customExerciseVideos` de más arriba.
      //
      // Va ATRASADO por construcción: el trigger corre DESPUÉS de que el
      // objeto aterrizó. Una ráfaga de N subidas paralelas se evalúa toda
      // contra el mismo valor viejo y se pasa por el tamaño de la ráfaga. La
      // regla es el gate preventivo que atrapa el caso normal —el composer
      // sube de a uno (`if (state.uploading) return`)— y la CF es la red
      // reactiva que borra el excedente.
      //
      // ⚠️ La suma incluye el archivo entrante (`used + size <= cap`) y no
      // sólo el acumulado: con `used < cap` alguien a 249 MB metería otros
      // 50 y el tope se pasaría por un archivo entero cada vez. La CF espeja
      // este mismo corte acumulando de más viejo a más nuevo.
      //
      // ── Fail-open, y hasta dónde ───────────────────────────────────────
      //
      // Sin doc de perfil `firestore.get()` devuelve null ⇒ no enforced, igual
      // que en `customExerciseVideos` y que `paywallEnforcedFor` en
      // `firestore.rules`. Pero el TECHO ESTRUCTURAL (50 MB por video, 5 GB
      // totales) se aplica siempre: el fail-open afloja el tope del paywall,
      // nunca el del producto.
      //
      // Y el PF nunca cae en el tope free: `athletePaywallEnforced` sale de
      // `resolveAthletePaywallEnforced`, que corta en
      // `if (userData?.role !== "athlete") return false` y también ante un
      // vínculo activo. O sea que el chat del Coach queda intacto EN LAS DOS
      // PUNTAS —el PF y su alumno vinculado— y el tope free pega sólo en el
      // atleta suelto, que es justo quien usa los chats sociales y de consulta
      // donde está el 94% de los bytes medidos.
      //
      // UNA sola función y UNA sola lectura de Firestore, por el mismo motivo
      // que en `customExerciseVideos`: cada `firestore.get()` es una lectura
      // facturada. Este bloque ya paga una en el `get` (la membresía); ésta es
      // la del `write`, y son caminos distintos, así que no se suman.
      function chatMediaWriteAllowed(userId) {
        let u = firestore.get(/databases/(default)/documents/users/$(userId));
        let d = u == null ? {} : u.data;
        let enforced = d.get('athletePaywallEnforced', false) == true;
        let usage = d.get('chatMediaUsage', {});
        let size = request.resource.size;
        return (
                 (request.resource.contentType.matches('image/.*')
                  && size < 15 * 1024 * 1024)
                 ||
                 (request.resource.contentType.matches('video/.*')
                  && size < (enforced ? 25 * 1024 * 1024 : 50 * 1024 * 1024))
               )
               && usage.get('bytes', 0) + size
                    <= (enforced ? 250 * 1024 * 1024
                                 : 5 * 1024 * 1024 * 1024);
      }

      // Only the owner can upload; content type and size are allowlisted.
      allow write: if request.auth != null
                  && request.auth.uid == userId
                  && chatMediaWriteAllowed(userId);

      // Only the owner can delete (cleanup on send failure or exercise removal).
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Coach Hub — archivos que el PF sube para un alumno.
    //
    // Path: /athleteFiles/{trainerId}_{athleteId}/{file}
    //
    // Storage queda trainer-only. El alumno abre `downloadUrl` desde
    // `_ArchivoRow._open()` con `LaunchMode.externalApplication`: esas URLs
    // llevan un token de descarga y no pasan por estas rules. Autorizar por
    // `pairId.split('_')[1] == uid` también abriría los archivos no compartidos
    // a quien conozca su path; la visibilidad se decide en el doc de Firestore.
    // Enforce del par en el prefijo del path (`trainerId_athleteId`) evita que
    // otro PF liste archivos ajenos.
    //
    // Content types permitidos: PDF + imágenes. Videos y otros formatos
    // se rechazan explícitamente para MVP.
    //
    // Size limit: 10 MB, mirror del cap en el repository y en la Firestore
    // rule sobre athlete_files.
    match /athleteFiles/{pairId}/{file=**} {
      // Solo el trainer del par lee/escribe. Verificamos que `pairId`
      // arranque con el uid del caller — si arranca con otro uid, es un
      // fishing attempt y lo bloqueamos.
      allow read: if request.auth != null
                  && pairId.split('_')[0] == request.auth.uid;

      allow write: if request.auth != null
                   && pairId.split('_')[0] == request.auth.uid
                   && (
                        (request.resource.contentType == 'application/pdf'
                         && request.resource.size < 10 * 1024 * 1024)
                        ||
                        (request.resource.contentType.matches('image/.*')
                         && request.resource.size < 10 * 1024 * 1024)
                      );

      allow delete: if request.auth != null
                    && pairId.split('_')[0] == request.auth.uid;
    }

    // Post photos — foto opcional de un post de share-a-workout.
    //
    // Path: /postPhotos/{userId}/{postId}.{ext}
    //
    // Mismo estilo simple que avatars/customExerciseVideos: solo el dueño
    // escribe bajo su carpeta, imágenes hasta 15 MB (espejo del guard
    // client-side en PostPhotoUploadService), cualquier autenticado hace
    // `get` (la visibilidad real del post la gobierna firestore.rules sobre
    // posts/ — la URL con token solo viaja dentro del doc del post). `list`
    // cerrado incondicionalmente para no enumerar las fotos de otro usuario.
    match /postPhotos/{userId}/{fileName} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if request.auth != null
                  && request.auth.uid == userId
                  && request.resource.size < 15 * 1024 * 1024
                  && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Feedback del alumno por ejercicio durante la sesión (#628) — la foto
    // opcional que acompaña un comentario o una MOLESTIA.
    //
    // Path: /sessionFeedback/{userId}/{sessionId}/{fileName}
    //
    // ⚠️ ESTO ES DATO DE SALUD, no una foto de post. El `get` NO puede ser
    // `request.auth != null` como en avatars/customExerciseVideos/postPhotos:
    // acá la foto es "dónde me duele". Se gatea con el MISMO grant de dos
    // partes que gobierna la sesión en firestore.rules — dueño OR el PF que
    // el alumno nombró en `session_shares/{userId}` — usando la llamada
    // cross-service que ya prueba el bloque `chatMedia` de más arriba.
    //
    // El dueño va PRIMERO en el `||` para que corte antes de tocar Firestore:
    // el alumno bajando su propia foto no debe depender de que exista el
    // grant, ni pagar dos lecturas por objeto.
    //
    // La literal `(default)` es obligatoria — las reglas de Storage no tienen
    // wildcard `$(database)` (misma nota que en chatMedia).
    //
    // ⚠️ Este gate NO es el que de verdad protege la foto. La URL que emite
    // getDownloadURL() lleva `?alt=media&token=` y es una credencial al
    // portador que NO evalúa estas reglas (docs/security.md §3.1, medido).
    // Quien custodia la foto es el documento de Firestore donde vive esa URL:
    // `users/{uid}/sessions/{sid}/exerciseFeedback/{id}`, con el mismo
    // predicado de dos partes. Este bloque es defensa en profundidad para el
    // único camino que sí pasa por las reglas: resolver el objeto por `ref()`.
    //
    // `list` cerrado INCONDICIONALMENTE, ni siquiera para el dueño. Es el
    // patrón de postPhotos/chatMedia y no el de avatars/customExerciseVideos,
    // que tienen `list` abierto y son los leaks confirmados QA-SEC-007 y
    // QA-SEC-008 (docs/security.md §3.6). Enumerar `sessionFeedback/{uid}/`
    // publicaría en QUÉ sesiones un alumno reportó dolor sin bajar un solo
    // byte — el nombre del prefijo ya es el dato sensible.
    //
    // `delete` propio explícito, no heredado: docs/security.md §3.8 regla 3 —
    // todo bloque con `request.resource.<algo>` necesita su `allow delete` o
    // el borrado falla en silencio (la lección de QA-SEC-009 en avatars).
    //
    // Size limit: 15 MB, espejo del guard client-side, igual que postPhotos.
    match /sessionFeedback/{userId}/{sessionId}/{fileName} {
      allow get: if request.auth != null
                 && (
                      request.auth.uid == userId
                      || (
                           firestore.exists(
                             /databases/(default)/documents/session_shares/$(userId))
                           && firestore.get(
                                /databases/(default)/documents/session_shares/$(userId)
                              ).data.trainerId == request.auth.uid
                         )
                    );

      allow list: if false;

      allow write: if request.auth != null
                  && request.auth.uid == userId
                  && request.resource.size < 15 * 1024 * 1024
                  && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Default: deny all other access.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
