rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Shared value guards (QA #508) ────────────────────────────────────────
    // Generic optional-field validators, visible to every nested match. Unlike
    // the domain helpers further down (postSameGym, reactionPostReadable,
    // …) these carry no collection knowledge, so they live at the top scope
    // instead of being duplicated per block.
    //
    // They take the VALUE, not the field name — always call them as
    // `optNumInRange(request.resource.data.get('weightKg', null), 0, 500)`.
    // Reading through `get(field, null)` collapses "key absent" and "key
    // present but null" into the same null, which matters because
    // json_serializable emits EVERY optional key with an explicit null (no
    // `includeIfNull: false` on these models) — a present-null key is the
    // NORMAL wire shape, not an anomaly, so the guards must accept it and
    // constrain only non-null values.

    // Optional number within an inclusive [minV, maxV] range.
    function optNumInRange(v, minV, maxV) {
      return v == null || (v is number && v >= minV && v <= maxV);
    }

    // Optional number that must be strictly positive, capped at maxV.
    function optPositiveNum(v, maxV) {
      return v == null || (v is number && v > 0 && v <= maxV);
    }

    // Optional string no longer than maxLen.
    function optStrMaxLen(v, maxLen) {
      return v == null || (v is string && v.size() <= maxLen);
    }

    // ── Grafo social dirigido (change `follow-model`) ─────────────────────────
    // Domain helper a top scope A PROPÓSITO, y es la única excepción a la regla
    // de arriba: lo consumen dos bloques `match` que no se contienen entre sí
    // (`/posts` — con su subcolección `/reactions` — y `/chats` — con su
    // subcolección `/messages`). Duplicarlo sería garantizar que en algún
    // momento las dos copias digan cosas distintas sobre quién ve qué.
    //
    // `follows/{followerUid}_{followeeUid}` — el doc id NO se ordena. Ahí vive
    // toda la asimetría del modelo: `{A}_{B}` y `{B}_{A}` son documentos
    // DISTINTOS, así que "A sigue a B pero B no a A" se representa, y "¿f sigue
    // a t?" se resuelve con un lookup directo por doc id — sin queries, sin
    // índices, mismo costo que el `exists`+`get` sobre `friendships` que
    // reemplaza. Si el id se ordenara, las dos direcciones colisionarían en el
    // mismo doc y volveríamos exactamente al problema que este change arregla.
    function followAccepted(f, t) {
      let id = f + '_' + t;
      return exists(/databases/$(database)/documents/follows/$(id))
          && get(/databases/$(database)/documents/follows/$(id)).data.status == 'accepted';
    }

    match /users/{uid} {
      // Owner-only read.
      allow read: if request.auth != null
                  && request.auth.uid == uid;

      // Create: only the authenticated user can create their own doc, uid MUST
      // match doc id, and self-registration is ALWAYS 'athlete'. The 'trainer'
      // role is intrinsic (AGENTS.md rule 3) and provisioned exclusively via the
      // Admin SDK, which bypasses these rules — so the client must never be able
      // to mint a trainer. QA-SEC-001: allowing role in ['athlete','trainer']
      // here let any client self-assign trainer (privilege escalation) and, since
      // update pins role immutable, it was permanent.
      //
      // `blockedAthleteIds` no puede venir en el create. La clausula de update
      // lo pinea equal-to-existing, asi que un valor SEMBRADO ACA seria
      // INDELEBLE desde el cliente: el duenio ya no puede sacarlo y
      // reconcileEntitlements solo corre para PFs, o sea que en un doc con
      // role 'athlete' el array plantado sobrevive indefinidamente. Y el rol
      // trainer se aprovisiona por Admin SDK SOBRE un doc que nacio athlete,
      // asi que el array plantado entraria al doc de entrenador. Se admite
      // null explicito (mismo idiom get(...,null) que el update); el modelo
      // Dart no emite el campo, asi que ningun create legitimo lo manda.
      //
      // `subscription` y `weightedLoad` van por el MISMO motivo, y ese agujero
      // era explotable HOY — verificado contra el emulador antes de cerrarlo:
      //
      //   create con subscription {tier:'plan3', status:'active'}  -> PERMITIDO
      //   despues, update para sacarsela                           -> denegado
      //   subscription que queda en el doc                         -> plan3
      //
      // O sea que el pin de update, que existe para proteger esos campos, los
      // volvia INDELEBLES: cualquiera se auto-registraba con el plan mas caro
      // forjado y ya no habia escritura de cliente que lo revirtiera. El rol
      // creado es 'athlete' y el paywall mide entrenadores, asi que no se cobra
      // solo — pero los PF se aprovisionan a mano con el Admin SDK sobre el doc
      // que YA existe, y un `update({role:'trainer'})` deja la suscripcion
      // forjada intacta. El costo de cerrarlo es una linea; el de dejarlo
      // abierto es descubrirlo cuando alguien ya lo uso.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && request.resource.data.role == 'athlete'
                    && request.resource.data.get('blockedAthleteIds', null) == null
                    && request.resource.data.get('subscription', null) == null
                    && request.resource.data.get('weightedLoad', null) == null;

      // Update: only the owner can update, and the four immutable fields
      // MUST equal their previous values. Trainers via Admin SDK only;
      // email changes via FirebaseAuth re-verification flow.
      //
      // Paywall Fase 7 PR1 (design §5.1): `subscription` (whole map) and
      // `weightedLoad` are CF-write-only. Follows the `payments` field-pin
      // idiom (firestore.rules ~1112-1134) — pinned equal-to-existing via
      // get(...,null) so absence on both sides is a no-op match. The owner
      // can still freely update every OTHER field on their own doc; only
      // the paywall fields pinned below are locked out. Admin SDK (CFs)
      // bypass rules entirely, so createPreapproval/mpWebhook/downgrade/
      // reactivation CFs write them normally.
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    // uid: identity — must equal doc id forever.
                    && request.resource.data.uid == resource.data.uid
                    // role: AGENTS.md rule 3 — intrinsic, never client-mutable.
                    && request.resource.data.role == resource.data.role
                    // email: must use FirebaseAuth.updateEmail re-verification.
                    && request.resource.data.email == resource.data.email
                    // createdAt: audit field — preserves analytics integrity.
                    && request.resource.data.createdAt == resource.data.createdAt
                    // subscription/weightedLoad: CF-write-only (paywall Fase 7).
                    && request.resource.data.get('subscription', null) == resource.data.get('subscription', null)
                    && request.resource.data.get('weightedLoad', null) == resource.data.get('weightedLoad', null)
                    // blockedAthleteIds: CF-write-only. Es la copia denormalizada
                    // de QUE alumnos quedaron fuera del cupo, escrita por
                    // reconcileEntitlements (sync-entitlements.ts). Sin este pin
                    // el PF se la vacía con un solo update desde el cliente, y
                    // como esa escritura no toca el mapa `subscription`,
                    // `subscriptionChanged` da false y ningún trigger reconcilia:
                    // la mentira sobrevive hasta el barrido de las 04:00. Hoy el
                    // campo es INERTE — ninguna cláusula lo LEE para autorizar
                    // nada, y este pin no cambia eso: restringe quién lo escribe,
                    // no qué se puede leer. Se pinea ANTES del enforcement a
                    // propósito, porque el día que una regla lo lea el bypass ya
                    // sería de una sola escritura.
                    //
                    // "CF-write-only" vale para los DOS verbos: el `allow
                    // create` de arriba rechaza el campo, porque este pin
                    // convierte en INDELEBLE cualquier valor sembrado al
                    // crear el doc. Un pin de la mitad de los verbos es peor
                    // que ninguno: el que lee el comentario da por cerrado lo
                    // que quedó abierto.
                    && request.resource.data.get('blockedAthleteIds', null) == resource.data.get('blockedAthleteIds', null)
                    // Notification inbox read cursor: owner-writeable, timestamp-only.
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['notificationsLastSeenAt'])
                        || request.resource.data.notificationsLastSeenAt is timestamp);

      // Delete denied — account deletion goes through privileged Cloud Function.
      allow delete: if false;

      match /notifications/{notificationId} {
        // History is private to the owning user.
        allow read: if request.auth != null
                    && request.auth.uid == uid;

        // Only notification Cloud Functions may create or mutate history.
        // Admin SDK writes bypass Firestore Security Rules.
        allow create, update: if false;

        // Owners may remove individual history entries.
        allow delete: if request.auth != null
                      && request.auth.uid == uid;
      }
    }

    match /exercises/{exerciseId} {
      // Catálogo público para usuarios autenticados.
      allow read: if request.auth != null;
      // Catálogo writeable solo via Admin SDK (seed script).
      allow write: if false;
    }

    match /routines/{routineId} {
      // ── Allowlist de campos de una rutina `user-created` ─────────────────
      // Fuente ÚNICA de verdad, consumida por el `create` del atleta
      // (CREATE branch 2) y por su `update` (UPDATE path 2).
      //
      // Vivía como literal duplicable en el update, y el create NO tenía
      // allowlist ninguno. Esa asimetría es un brick silencioso: el create
      // aceptaba CUALQUIER clave extra y el update la rechazaba después, así
      // que una rutina creada con un campo desconocido no se podía editar
      // NUNCA — y el permission-denied aparecía recién en la primera edición,
      // lejos de la escritura que lo causó. Es el modo de falla de #563.
      //
      // Lo que lo vuelve alcanzable es #647 ("usar como base"): hasta ahora
      // TODO payload de rutina de atleta se armaba desde un literal fijo en
      // `_submit`; copiar una plantilla es el primer flujo donde el contenido
      // sale de OTRO documento. Con el guard, un campo ajeno falla en el
      // create — fuerte y en el acto — en vez de bloquear la edición meses
      // después.
      //
      // `ratingAvg`/`ratingsCount` figuran acá por el update (un doc que
      // alguna vez recibió agregados de la CF tiene que seguir siendo
      // editable). En el create los rechaza aparte su propio guard de
      // ausencia, que es más estricto y manda.
      //
      // ⚠️  COUPLING WARNING: esta lista tiene que contener TODO campo que
      // guarde una rutina `user-created`. Si agregás uno al modelo Routine, a
      // `createUserOwned` o a `updateUserOwned`, agregalo acá también —
      // si no, se rompen create Y update a la vez.
      function userCreatedRoutineFields() {
        return ['name', 'level', 'days',
                'source', 'createdBy', 'visibility', 'createdAt', 'status',
                'split', 'estimatedMinutesPerDay', 'imageUrl', 'numWeeks',
                'ratingAvg', 'ratingsCount', 'summary', 'goals'];
      }

      // Read: público para autenticados si la rutina es `visibility: 'public'`
      // (default histórico — todas las plantillas seedeadas sin el campo
      // explícito caen en este branch). Si la rutina es privada
      // (`visibility: 'private'`), solo `assignedBy` (PF) o `assignedTo`
      // (atleta) pueden leerla. REQ-COACH-FOUNDATIONS-006.
      //
      // ⚠️  `resource == null` NO es opcional — es el guard de existencia.
      // En un `get` sobre un doc INEXISTENTE, `resource` es null, y cualquier
      // desreferencia de `resource.data` (p. ej. `'visibility' in resource.data`)
      // hace fallar la EVALUACIÓN de la regla → la lectura vuelve como
      // PERMISSION_DENIED, no como un snapshot vacío. Sin este short-circuit,
      // `getById()` de una rutina borrada TIRA EXCEPCIÓN en vez de devolver
      // null, y el `if (!snap.exists)` del cliente es código muerto que nunca
      // se ejecuta. Eso rompió los radares de distribución muscular: una sola
      // sesión vieja apuntando a una rutina borrada dejaba el gráfico entero
      // en blanco.
      // El único dato que expone es "este id no existe" vs "existe pero es
      // privado" — los auto-ids de Firestore son de 20 chars aleatorios, así
      // que no habilita enumeración.
      // Sólo aplica a `get`: en un `list` (query) `resource` es cada doc
      // candidato y nunca es null, así que las queries no se ven afectadas.
      // Verificado contra el emulador: con SÓLO este disyunto, el `list` de un
      // tercero se DENIEGA correctamente.
      //
      // 🔒  NO reintroducir `!('visibility' in resource.data)` acá, ni ninguna
      // otra prueba de EXISTENCIA de campo sobre `resource.data`.
      // Esa línea vivió acá y abría un leak total: en un `list`, el motor de
      // reglas NO evalúa `'x' in resource.data` por documento — trata el
      // disyunto como posiblemente verdadero y PERMITE la query entera. Con
      // ella puesta, cualquier autenticado corría
      // `collection('routines').get()` y se llevaba TODAS las rutinas de la
      // base, incluidas las privadas de otros alumnos, junto con el grafo
      // assignedBy/assignedTo de toda la plataforma. El `get` seguía denegado,
      // así que el agujero era invisible salvo que se probara el `list`.
      // Aislado por bisección de los 8 disyuntos; lo pinea
      // routines-list-leak-rules.test.ts.
      //
      // El caso legacy que aquella línea cubría —docs sin el campo— ahora lo
      // resuelve `.get('visibility', 'private')`, que es total y no rompe la
      // evaluación del `list`. Falla cerrado: un doc sin `visibility` queda
      // privado. No se pierde nada legítimo: sus dueños lo siguen leyendo por
      // las ramas assignedTo/assignedBy/createdBy de abajo, y el catálogo de la
      // app ya filtra `where('visibility', isEqualTo: 'public')`
      // (routine_repository.dart:36 y :52), así que Firestore YA descartaba los
      // docs sin el campo.
      allow read: if request.auth != null
                  && (resource == null
                      || resource.data.get('visibility', 'private') == 'public'
                      //
                      // 🔒  `'shared'` NO va acá (QA-SEC-012, #779). Estuvo,
                      // sin una sola línea de comentario, en una regla donde
                      // cada otro disyunto tiene párrafos de justificación.
                      //
                      // El dominio declara ese valor RESERVADO y sin uso
                      // (`routine_visibility.dart:6`: "extensión futura —
                      // reservado para iteración futura, no se usa en Etapa
                      // 1"), y aun así la lectura lo trataba IGUAL que
                      // 'public': get y list para cualquier autenticado. Es
                      // un permiso mundial ya concedido a una feature que
                      // todavía no se diseñó.
                      //
                      // Lo que más pesaba era el `list`: medido contra el
                      // emulador, un tercero corría
                      // `where('visibility', '==', 'shared')` y se llevaba
                      // `assignedBy` + `assignedTo` de cada doc — el grafo
                      // PF↔alumno de toda la plataforma.
                      //
                      // La escritura, además, lo pensó con el modelo mental
                      // OPUESTO: CREATE branch 1 acepta 'shared' sólo en
                      // planes trainer-assigned ("'shared' is trainer-assigned
                      // only", ver el update de abajo), o sea MÁS restringido
                      // que 'public'. La lectura era la mitad incoherente.
                      //
                      // El `create` sigue aceptando 'shared' A PROPÓSITO: sin
                      // este disyunto un doc 'shared' queda legible sólo por
                      // assignedTo / assignedBy / createdBy, que es fallar
                      // CERRADO. El día que se diseñe "planes compartidos
                      // entre múltiples atletas", esa feature decide a quién
                      // abre — no una línea escrita años antes. Lo pinea
                      // routines-list-leak-rules.test.ts.
                      || request.auth.uid == resource.data.assignedTo
                      || request.auth.uid == resource.data.assignedBy
                      || request.auth.uid == resource.data.createdBy // REQ-USR-008, SCENARIO-605
                      // Trainer-public templates: any authenticated user
                      // can read a `trainer-template` doc IF the owning
                      // trainer flipped `sharedTemplatesWithAthletes` on
                      // their public profile. The athlete client filters
                      // results by their linked trainer's uid; non-linked
                      // users could technically query but it's the same
                      // privacy model as the public system catalogue.
                      || (resource.data.source == 'trainer-template'
                          && get(/databases/$(database)/documents/userPublicProfiles/$(resource.data.assignedBy)).data.sharedTemplatesWithAthletes == true));

      // CREATE branch 1: trainer-assigned + trainer-template.
      // - assignedBy debe coincidir con el uid del caller (anti-spoofing).
      // - assignedBy debe coincidir con el uid del caller (anti-spoofing).
      // - source debe ser 'trainer-assigned' (no system, no user).
      // - visibility debe ser 'private' o 'shared' (no 'public').
      // - assignedTo debe ser un string no vacío (uid del atleta destino).
      // REQ-COACH-PLANS-005..010, SCENARIO-438..443.
      allow create: if request.auth != null
                    && request.resource.data.assignedBy == request.auth.uid
                    // Community rating aggregates are CF-write-only (Fase W3):
                    // a create must not seed forged starting values — a trainer
                    // could otherwise mint a template pre-loaded with a 5.0
                    // average before publishing it. The client never emits
                    // these keys (Routine uses @JsonKey(includeToJson: false)).
                    && !('ratingAvg' in request.resource.data)
                    && !('ratingsCount' in request.resource.data)
                    && (
                      // Trainer-assigned plan for a specific athlete.
                      (request.resource.data.source == 'trainer-assigned'
                        && request.resource.data.visibility in ['private', 'shared']
                        && request.resource.data.assignedTo is string
                        && request.resource.data.assignedTo.size() > 0)
                      ||
                      // Trainer template — no athlete assigned. Owner-only
                      // read is already covered by the read rule via the
                      // `assignedBy == uid` branch. json_serializable emits
                      // `'assignedTo': null` literally (the field is present
                      // with null value), so we compare against null directly
                      // — `.get('assignedTo', '')` would return null (not the
                      // default '') because the key DOES exist.
                      (request.resource.data.source == 'trainer-template'
                        && request.resource.data.visibility == 'private'
                        && request.resource.data.assignedTo == null)
                    );

      // CREATE branch 2 (NEW): athlete self-authored — 6 conditions, all must pass.
      // REQ-USR-004, REQ-USR-009, REQ-USR-012, REQ-USR-014, ADR-USR-03, ADR-USR-06.
      // SCENARIO-600..604.
      //
      // Visibility clamped to {'private', 'public'} — the athlete may opt in
      // at create time to share the routine on their public profile. `shared`
      // stays trainer-assigned only (that path is branch 1 above).
      allow create: if request.auth != null
                    && request.resource.data.source == 'user-created'
                    && request.resource.data.createdBy == request.auth.uid   // anti-spoofing (REQ-USR-014)
                    && request.resource.data.visibility in ['private', 'public']
                    && !('assignedBy' in request.resource.data)              // must be absent (REQ-USR-004)
                    && !('assignedTo' in request.resource.data)              // must be absent (REQ-USR-004)
                    // Rating aggregates are CF-write-only (Fase W3) — same
                    // absence guard as branch 1.
                    && !('ratingAvg' in request.resource.data)
                    && !('ratingsCount' in request.resource.data)
                    && request.resource.data.createdAt is timestamp
                    // Ningún campo fuera del set conocido (#647). Simétrico
                    // con el `hasOnly` de UPDATE path 2 y con la MISMA lista:
                    // lo que se puede crear es exactamente lo que después se
                    // puede editar. Ver `userCreatedRoutineFields()`.
                    && request.resource.data.keys()
                         .hasOnly(userCreatedRoutineFields());

      // UPDATE path 1 (narrow): owner flips only `status` — archive / restore.
      // REQ-USR-013, SCENARIO-607, SCENARIO-608.
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.createdBy
                    && resource.data.source == 'user-created'
                    && request.resource.data.diff(resource.data).affectedKeys()
                         == ['status'].toSet()
                    && request.resource.data.status in ['active', 'archived'];

      // UPDATE path 2: owner edits content fields (name, level, days).
      // REQ-USR-018, ADR-USR-03.
      //
      // Invariants enforced server-side (mirrors client guards in
      // RoutineRepository.updateUserOwned and the create rule):
      //   - Only the owner (createdBy == auth.uid) may update.
      //   - source must remain 'user-created' (cannot escalate to system/trainer).
      //   - createdBy must not change (immutable owner identity).
      //   - visibility MAY change between 'private' and 'public' (REQ-USR-012
      //     reopened to support the "share to my public profile" feature —
      //     Instagram-style retroactive visibility toggle). The value must
      //     stay in {'private', 'public'}; 'shared' is trainer-assigned only.
      //   - createdAt must not change (audit field, immutable post-create).
      //   - assignedBy and assignedTo must be absent — user-created routines
      //     must never acquire trainer-assignment fields via a client write.
      //   - Only 'name', 'level', 'days', 'numWeeks', 'visibility' are the
      //     allowed mutable content keys (plus any subset). The payload must
      //     not contain keys outside the full known field set (hasOnly guard).
      //
      // ⚠️  COUPLING WARNING — hasOnly field list below:
      // This list MUST contain every field a user-created routine doc stores.
      // If you add a field to the Routine model, createUserOwned, or
      // updateUserOwned, you MUST add it here too — otherwise ALL athlete
      // routine updates will fail with permission-denied.
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.createdBy
                    && resource.data.source == 'user-created'
                    // Immutable identity fields must not change.
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.source == resource.data.source
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.status == resource.data.status
                    // Visibility may toggle but only within the owner-safe set.
                    && request.resource.data.visibility in ['private', 'public']
                    // Trainer-assignment fields must be absent (anti-hijack).
                    && !('assignedBy' in request.resource.data)
                    && !('assignedTo' in request.resource.data)
                    // Only content fields may appear in the written document.
                    // La lista vive en `userCreatedRoutineFields()`, arriba —
                    // compartida con el create para que las dos no puedan
                    // divergir. Ahí está el detalle de por qué figuran
                    // `ratingAvg`/`ratingsCount` (agregados de la CF) y
                    // `summary` (#648): son defensivos, para que un doc que
                    // los tenga siga siendo editable por su dueño. Ninguno
                    // de los tres está en el `affectedKeys` de abajo — el
                    // atleta convive con ellos, no los cambia.
                    && request.resource.data.keys()
                         .hasOnly(userCreatedRoutineFields())
                    // The diff must touch ONLY content fields (name/level/days/
                    // numWeeks/visibility).
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['name', 'level', 'days', 'numWeeks', 'visibility']);

      // UPDATE path 3: trainer edits content of a trainer-assigned plan.
      //
      // Invariants enforced server-side (mirrors client guards in
      // RoutineRepository.updateAssigned):
      //   - Only the assigning trainer (assignedBy == auth.uid) may update.
      //   - source must remain 'trainer-assigned'.
      //   - assignedBy must not change (immutable trainer identity).
      //   - assignedTo must not change (immutable athlete assignment).
      //   - createdBy must not change.
      //   - createdAt must not change (audit field).
      //   - Only 'name', 'split', 'level', 'days' are the allowed mutable
      //     content keys. The diff must touch only those fields.
      //   - The payload must not contain keys outside the full known field
      //     set (hasOnly guard).
      //
      // ⚠️  COUPLING WARNING — hasOnly field list below:
      // This list MUST contain every field a trainer-assigned routine doc
      // stores. If you add a field to the Routine model, createAssigned, or
      // updateAssigned, you MUST add it here too — otherwise ALL trainer plan
      // updates will fail with permission-denied.
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.assignedBy
                    && resource.data.source == 'trainer-assigned'
                    // Immutable identity fields must not change.
                    && request.resource.data.assignedBy == resource.data.assignedBy
                    && request.resource.data.assignedTo == resource.data.assignedTo
                    && request.resource.data.source == resource.data.source
                    && (!('createdBy' in resource.data)
                        || request.resource.data.createdBy == resource.data.createdBy)
                    && (!('createdAt' in resource.data)
                        || request.resource.data.createdAt == resource.data.createdAt)
                    // Only content fields may appear in the written document.
                    // ratingAvg/ratingsCount: defensively listed (same as the
                    // trainer-template path) so a doc that ever gained CF
                    // aggregates cannot brick the trainer's edits; the
                    // affectedKeys allowlist below still excludes them.
                    && request.resource.data.keys().hasOnly(
                         // + numWeeks (periodization, Model B) — mirror RoutineRepository.
                         ['name', 'split', 'level', 'days',
                         'source', 'assignedBy', 'assignedTo', 'visibility',
                         'status', 'createdBy', 'createdAt',
                         'estimatedMinutesPerDay', 'imageUrl', 'numWeeks',
                         'ratingAvg', 'ratingsCount', 'summary', 'goals'])
                       // summary (#648): lo escribe el PF, con tope de largo.
                       // El tope vive ACA y no en el cliente: un cliente
                       // parcheado no lo respetaria. Los 7 sembrados miden
                       // entre 61 y 100 caracteres; 280 deja margen sin
                       // habilitar un ensayo en el subtitulo de una tarjeta.
                       && optStrMaxLen(request.resource.data.get('summary', null), 280)
                    // The diff must touch ONLY content fields.
                    && request.resource.data.diff(resource.data).affectedKeys()
                         // + numWeeks (periodization) — repo always sends it.
                         // `goals` (#635 PR#1) NO va acá, y sí en el path de
                         // PLANTILLA de abajo. Un plan asignado es privado de un
                         // alumno: no aparece en la grilla de PLANTILLAS, así que
                         // nada lo rankea por objetivo, y `updateAssigned` tampoco
                         // lo manda. Darle permiso de escritura sería superficie
                         // que ningún cliente usa.
                         //
                         // Sí está en el `keys()` de arriba: un plan copiado desde
                         // una plantilla puede ARRASTRAR el campo, y sin eso su
                         // edición fallaría con permission-denied.
                         .hasOnly(['name', 'split', 'level', 'days', 'numWeeks',
                                   'summary']);

      // UPDATE path 4: trainer edits content of a trainer template.
      //
      // Invariants enforced server-side (mirrors client guards in
      // RoutineRepository.updateTemplate):
      //   - Only the owning trainer (assignedBy == auth.uid) may update.
      //   - source must remain 'trainer-template'.
      //   - assignedBy must not change (immutable trainer identity).
      //   - assignedTo must remain null (templates have no assigned athlete).
      //   - createdBy must not change.
      //   - createdAt must not change (audit field).
      //   - Only 'name', 'split', 'level', 'days' are the allowed mutable
      //     content keys. The diff must touch only those fields.
      //   - The payload must not contain keys outside the full known field
      //     set (hasOnly guard).
      //
      // ⚠️  COUPLING WARNING — hasOnly field list below:
      // This list MUST contain every field a trainer-template routine doc
      // stores. If you add a field to the Routine model, createTemplate, or
      // updateTemplate, you MUST add it here too — otherwise ALL trainer
      // template updates will fail with permission-denied.
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.assignedBy
                    && resource.data.source == 'trainer-template'
                    // Immutable identity fields must not change.
                    && request.resource.data.assignedBy == resource.data.assignedBy
                    && request.resource.data.assignedTo == null
                    && request.resource.data.source == resource.data.source
                    && (!('createdBy' in resource.data)
                        || request.resource.data.createdBy == resource.data.createdBy)
                    && (!('createdAt' in resource.data)
                        || request.resource.data.createdAt == resource.data.createdAt)
                    // Only content fields may appear in the written document.
                    // ratingAvg/ratingsCount ARE listed: request.resource.data
                    // is the POST-state of the doc, so once the
                    // templateRatingAggregate CF wrote aggregates onto a
                    // published template, every content edit would fail this
                    // hasOnly without them. They stay un-editable because the
                    // affectedKeys() allowlist below does NOT include them.
                    && request.resource.data.keys().hasOnly(
                         // + numWeeks (periodization, Model B) — mirror RoutineRepository.
                         ['name', 'split', 'level', 'days',
                         'source', 'assignedBy', 'assignedTo', 'visibility',
                         'status', 'createdBy', 'createdAt',
                         'estimatedMinutesPerDay', 'imageUrl', 'numWeeks',
                         'ratingAvg', 'ratingsCount', 'summary', 'goals'])
                       // summary (#648): lo escribe el PF, con tope de largo.
                       // El tope vive ACA y no en el cliente: un cliente
                       // parcheado no lo respetaria. Los 7 sembrados miden
                       // entre 61 y 100 caracteres; 280 deja margen sin
                       // habilitar un ensayo en el subtitulo de una tarjeta.
                       && optStrMaxLen(request.resource.data.get('summary', null), 280)
                    // The diff must touch ONLY content fields.
                    && request.resource.data.diff(resource.data).affectedKeys()
                         // + numWeeks (periodization) — repo always sends it.
                         // + goals (#635 PR#1): el PF declara para qué sirve la
                         //   plantilla, y lo edita. Va acá Y en el `keys()` de
                         //   arriba. En el path del ATLETA va sólo en `keys()`:
                         //   convive con el campo pero no lo cambia, porque el
                         //   objetivo es una afirmación de quien publica, no una
                         //   preferencia de quien la usa. Mismo reparto
                         //   asimétrico que `summary`.
                         .hasOnly(['name', 'split', 'level', 'days', 'numWeeks',
                                   'summary', 'goals']);

      // UPDATE path 5 (narrow, Fase W3): the owning trainer publishes /
      // unpublishes their template — flips ONLY `visibility` between
      // 'private' and 'public'. Mirrors the "status flip" idiom of UPDATE
      // path 1. 'shared' is NOT accepted here (trainer-assigned concept),
      // and the visibility-only diff means content edits, aggregate forgery,
      // or ownership changes can never ride along on this path. Any
      // authenticated user can then read the published doc via the existing
      // `visibility == 'public'` branch of the read rule above.
      // The role gate mirrors the "any athlete-role user forges X" guards
      // used across the file: CREATE branch 1 predates role checks, so an
      // athlete CAN hold a private forged `trainer-template` doc — without
      // this gate, path 5 would let them publish it into the community
      // catalogue (and collect ratings on it).
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.assignedBy
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'
                    && resource.data.source == 'trainer-template'
                    && request.resource.data.diff(resource.data).affectedKeys()
                         == ['visibility'].toSet()
                    && request.resource.data.visibility in ['private', 'public'];

      // DELETE (narrow): the owning trainer may delete their OWN
      // `trainer-template` docs (library cleanup) and `trainer-assigned`
      // plans (manually remove a plan from an athlete). User/system routines
      // remain undeletable, and the athlete (assignedTo) cannot delete.
      allow delete: if request.auth != null
                    && resource.data.source in ['trainer-template', 'trainer-assigned']
                    && request.auth.uid == resource.data.assignedBy;
    }

    // Community ratings on published trainer templates (Fase W3).
    // One doc per rater — the doc id IS the rater's uid (upsert semantics,
    // mirroring /reviews' deterministic-id idiom). Aggregated into the parent
    // routine's `ratingAvg`/`ratingsCount` by the `templateRatingAggregate`
    // CF (Admin SDK — bypasses these rules); the client NEVER writes those
    // aggregate fields.
    match /routines/{routineId}/ratings/{userId} {
      function ratedRoutine() {
        return get(/databases/$(database)/documents/routines/$(routineId)).data;
      }

      // The parent must be a community-published trainer template, and the
      // template's own author cannot rate their work (anti self-boosting).
      // A missing parent doc makes get() fail the evaluation → deny, so
      // ratings can never be attached to nonexistent routines.
      function parentIsRateable() {
        return ratedRoutine().source == 'trainer-template'
               && ratedRoutine().visibility == 'public'
               && ratedRoutine().assignedBy != request.auth.uid;
      }

      // Payload shape shared by create/update. Mirrors /reviews: rating is a
      // 1..5 int, comment absent/null or ≤500 chars.
      function ratingPayloadOk() {
        return request.resource.data.keys().hasOnly(
                 ['userId', 'rating', 'comment', 'createdAt', 'updatedAt'])
               && request.resource.data.userId == userId
               && request.resource.data.rating is int
               && request.resource.data.rating >= 1
               && request.resource.data.rating <= 5
               // optStrMaxLen (shared guard, QA #508) — the `is string`
               // check matters: `.size()` is also defined for lists/maps,
               // so a bare size check would accept a List/Map comment that
               // later explodes the `as String?` cast in every client
               // reading this template's ratings.
               && optStrMaxLen(request.resource.data.get('comment', null), 500)
               && request.resource.data.createdAt is timestamp
               && request.resource.data.updatedAt is timestamp;
      }

      // Read: any authenticated user — same openness as /reviews. Ratings on
      // a template someone unpublished stay technically readable by id, but
      // routine auto-ids are 20 random chars (no enumeration), matching the
      // privacy stance documented on the routines read rule.
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && parentIsRateable()
                    && ratingPayloadOk();

      // Editing my own rating keeps identity + createdAt pinned; requires
      // the template to still be published (an unpublished template freezes
      // its ratings until the trainer republishes).
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && parentIsRateable()
                    && ratingPayloadOk()
                    && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    // Vínculo PF ↔ atleta (Fase 5 Etapa 1, REQ-COACH-FOUNDATIONS-004).
    // Doc id auto-generado. Permite múltiples vínculos históricos por par.
    match /trainer_links/{linkId} {
      // Read: solo members (trainer o athlete del vínculo) o doc inexistente.
      // El branch `resource == null` permite getByPair queries que no
      // matchean leak-free.
      allow read: if request.auth != null
                  && (resource == null
                      || request.auth.uid == resource.data.trainerId
                      || request.auth.uid == resource.data.athleteId);

      // Create: solo el atleta inicia un request (convención producto).
      // Status inicial debe ser `pending`. trainerId != athleteId.
      //
      // `acceptedAt` no puede venir con valor. El pin de update (más abajo) lo
      // congela equal-to-existing, pero el create es la OTRA mitad del camino
      // de escritura y el cliente sí pasa por acá: `TrainerLinkRepository.
      // request()` hace `ref.set(link.toJson())`, y el toJson generado emite
      // `acceptedAt` — con null, porque un pending todavía no fue aceptado.
      // Sin este pin el atleta sembraba una antigüedad de 1970 en su propio
      // vínculo, y `acceptedAt` es la ÚNICA clave de orden de
      // reconcileEntitlements: el que entró primero conserva el cupo. Hoy no
      // se explota (promote-link.ts pisa el campo al aceptar, y un `pending`
      // ni siquiera entra al sort), pero la rama `resume` del MISMO tx.update
      // ya preserva `acceptedAt`, así que alcanza con una transición futura
      // que promueva sin pisarlo para que la antigüedad forjada gane.
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.athleteId
                    && request.auth.uid != request.resource.data.trainerId
                    && request.resource.data.status == 'pending'
                    && request.resource.data.trainerId is string
                    && request.resource.data.trainerId.size() > 0
                    && request.resource.data.get('acceptedAt', null) == null;

      // Update: members del vínculo pueden actualizar (decline / cancel /
      // terminate / pause). Fields `trainerId`, `athleteId`, `requestedAt`,
      // `acceptedAt` son inmutables. `accept` y `resume` YA NO son client-side:
      // viven en sus callables (paywall Fase 7 PR4) porque son las dos
      // transiciones que suben el peso ponderado y desde el cliente el límite
      // era inaplicable.
      //
      // Privacy gate (REQ-COACH-LINK-012..014): el último OR clause restringe
      // la mutación de `sharedWithTrainer` exclusivamente al atleta. Si el
      // request cambia el campo (`request.resource.data.sharedWithTrainer !=
      // resource.data.sharedWithTrainer`), el auth.uid debe ser el atleta.
      // El PF nunca puede flippear el flag.
      //
      // Paywall Fase 7 PR1 (design §5.2): `entitlement`, `blockedAt`,
      // `blockedReason` son CF-write-only — pinneados equal-to-existing via
      // get(...,null) (mismo idioma que `payments`, firestore.rules
      // ~1112-1134). Solo el downgrade CF y las callables de promoción
      // (Admin SDK, bypasean rules) los escriben.
      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.trainerId
                        || request.auth.uid == resource.data.athleteId)
                    // ── Lock de promoción (paywall Fase 7 PR4) ──────────────
                    //
                    // `active` es CF-ONLY. Es la única forma de que el límite
                    // de alumnos sea real: mientras el cliente pudiera escribir
                    // `status: 'active'`, el gate de peso ponderado era una
                    // sugerencia. Las callables acceptTrainerLink y
                    // resumeTrainerLink usan el Admin SDK y bypasean rules.
                    //
                    // `paused` sigue siendo client-side pero SOLO del trainer
                    // (QA-SEC-002: si el atleta pudiera auto-promoverse a
                    // active/paused, forjaría un vínculo y fabricaría reviews
                    // contra cualquier PF — reviews gatea en
                    // status in ['active','paused']). Pausar BAJA el peso, así
                    // que no necesita gate.
                    //
                    // `terminated` lo puede escribir cualquier member
                    // (decline / cancel / terminate). También baja el peso.
                    //
                    // Volver a `pending` queda DENEGADO para todos. Es un
                    // endurecimiento nuevo, no un efecto colateral: la cláusula
                    // vieja permitía `!(status in ['active','paused'])`, o sea
                    // que cualquiera de los dos members podía reescribir un
                    // vínculo VIVO de vuelta a `pending`. Un re-request legítimo
                    // crea un doc nuevo, nunca revive el viejo.
                    && (request.resource.data.status == resource.data.status
                        || request.resource.data.status == 'terminated'
                        || (request.resource.data.status == 'paused'
                            && request.auth.uid == resource.data.trainerId))
                    && request.resource.data.trainerId == resource.data.trainerId
                    && request.resource.data.athleteId == resource.data.athleteId
                    && request.resource.data.requestedAt == resource.data.requestedAt
                    // acceptedAt: CF-write-only, y este pin es de DAÑO ENTRE
                    // USUARIOS, no de evasión. `acceptedAt` es la ÚNICA clave de
                    // orden de reconcileEntitlements (select-blocked-links.ts):
                    // cuando un PF se pasa del límite, conservan el cupo los
                    // vínculos más ANTIGUOS. Sin el pin, cualquiera de los dos
                    // members reescribe su propio `acceptedAt` — entra por la
                    // rama `status == resource.data.status`, sin tocar el status —
                    // y empuja a OTRO alumno fuera del cupo.
                    //
                    // El create es la otra mitad y está pinneado allá arriba
                    // (solo admite null): el cliente SÍ manda `acceptedAt` en
                    // el create, porque `TrainerLinkRepository.request()` hace
                    // `set(link.toJson())`. Con los dos verbos cerrados, los
                    // únicos escritores de un `acceptedAt` NO NULO son las
                    // callables acceptTrainerLink / resumeTrainerLink, que van
                    // por Admin SDK y bypasean rules.
                    && request.resource.data.get('acceptedAt', null) == resource.data.get('acceptedAt', null)
                    && (request.resource.data.sharedWithTrainer == resource.data.sharedWithTrainer
                        || request.auth.uid == resource.data.athleteId)
                    && request.resource.data.get('entitlement', null) == resource.data.get('entitlement', null)
                    && request.resource.data.get('blockedAt', null) == resource.data.get('blockedAt', null)
                    && request.resource.data.get('blockedReason', null) == resource.data.get('blockedReason', null);

      // Delete denegado — terminate vía update status='terminated'.
      allow delete: if false;
    }

    match /posts/{postId} {
      // QA-FEED-001: post privacy is enforced SERVER-SIDE (was client-side only,
      // REQ-PFM-009 — any authenticated user could read every post via the SDK).
      // A post is readable when it is public, is the caller's own, is a
      // 'friends' post whose author the CALLER FOLLOWS, or is a 'gym' post whose
      // authorGymId matches the caller's gym. The client feed queries are
      // already scoped to match (feedForFollowing by followee uids, feedForGym
      // by gym, profile by privacy tier), so these per-doc get()s only fire for
      // rows the query already narrowed to.
      //
      // REQ-FOLLOW-010: el tier dejó de preguntar "¿hay una amistad aceptada
      // entre los dos?" y pregunta "¿el LECTOR sigue al AUTOR?". La dirección
      // importa: que el autor me siga a mí no me da acceso a su contenido.
      // El literal 'friends' de `privacy` NO se toca (LD-05) — el rename del
      // tier es sólo del cliente y viaja por @JsonValue, así que los posts ya
      // escritos siguen siendo válidos y las allowlists de create/update quedan
      // byte-idénticas.
      function postFollowerAccepted(authorUid) {
        return followAccepted(request.auth.uid, authorUid);
      }
      function postSameGym(authorGymId) {
        return authorGymId != null
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.gymId == authorGymId;
      }

      allow read: if request.auth != null
                  && (
                    resource == null
                    || resource.data.privacy == 'public'
                    || request.auth.uid == resource.data.authorUid
                    || (resource.data.privacy == 'friends'
                        && postFollowerAccepted(resource.data.authorUid))
                    || (resource.data.privacy == 'gym'
                        && postSameGym(resource.data.get('authorGymId', null)))
                  );

      // Create: only the owner of the post — authorUid must equal caller uid.
      // SCENARIO-130: non-owner create is blocked.
      //
      // Shape hardening (share-composer PR1): allowlist de keys + bounds de
      // los campos abusables. OJO: `string.size()` en rules NO cuenta
      // caracteres user-visible — '💪'.repeat(280) mide > 280 (verificado
      // contra el emulador, ver post-create-shape-rules.test.ts), así que un
      // bound de 280 rompería posts legítimos con tildes/emoji. El cap de UX
      // (280 caracteres, kMaxPostChars) vive en el cliente; acá va 280 × 4 =
      // 1120 como techo anti-abuso (4 es el peso máximo de un code point en
      // UTF-8 — cubre tildes, CJK y emoji simples), mismo split cliente-corto
      // / rules-holgadas que el `text.size() < 5000` de chats.
      // `photoUrl` ≤ 600 vía optStrMaxLen (json_serializable emite la key
      // presente-con-null en posts sin foto — el helper la acepta);
      // `workoutSnapshot` solo se valida en su capa externa (map con
      // exercises list ≤ 30, espejo de kMaxSnapshotExercises) — la forma
      // anidada de cada set NO se valida (sin precedente en este archivo;
      // el límite de 1 MiB por doc es el backstop).
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.authorUid
                    && request.resource.data.keys().hasOnly([
                         'id', 'authorUid', 'authorDisplayName',
                         'authorAvatarUrl', 'authorGymId', 'text',
                         'routineTag', 'privacy', 'createdAt', 'workoutStats',
                         'photoUrl', 'workoutSnapshot'
                       ])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 1120
                    && request.resource.data.privacy in ['friends', 'gym', 'public']
                    && optStrMaxLen(request.resource.data.get('photoUrl', null), 600)
                    && (request.resource.data.get('workoutSnapshot', null) == null
                        || (request.resource.data.workoutSnapshot is map
                            && request.resource.data.workoutSnapshot.get('exercises', null) is list
                            && request.resource.data.workoutSnapshot.exercises.size() <= 30));

      // Update: only the original author, mismos bounds de shape que create —
      // sin esto el hardening del create es cosmético (el dueño podría inflar
      // `text` o meter keys nuevas vía update). En updates,
      // `request.resource.data` es el doc FINAL mergeado, así que las mismas
      // condiciones valen: docs legacy traen un subset de las keys permitidas
      // y pasan hasOnly igual.
      //
      // Campos inmutables pineados equal-to-existing (idioma get(...,null),
      // como `payments`): PostRepository.update solo edita text/privacy/
      // routineTag y su doc declara authorUid/authorGymId/author*/createdAt/id
      // inmutables — sin el pin, el dueño podía REASIGNAR authorUid y plantar
      // un post falso atribuido a otra persona en el feed de los amigos de la
      // víctima (o inyectar en el feed de otro gym vía authorGymId).
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.authorUid
                    && request.resource.data.authorUid == resource.data.authorUid
                    && request.resource.data.get('authorGymId', null) == resource.data.get('authorGymId', null)
                    && request.resource.data.get('authorDisplayName', null) == resource.data.get('authorDisplayName', null)
                    && request.resource.data.get('authorAvatarUrl', null) == resource.data.get('authorAvatarUrl', null)
                    && request.resource.data.get('id', null) == resource.data.get('id', null)
                    && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
                    && request.resource.data.get('reactionCounts', null) == resource.data.get('reactionCounts', null)
                    && request.resource.data.keys().hasOnly([
                         'id', 'authorUid', 'authorDisplayName',
                         'authorAvatarUrl', 'authorGymId', 'text',
                         'routineTag', 'privacy', 'createdAt', 'workoutStats',
                         'photoUrl', 'workoutSnapshot', 'reactionCounts'
                       ])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 1120
                    && request.resource.data.privacy in ['friends', 'gym', 'public']
                    && optStrMaxLen(request.resource.data.get('photoUrl', null), 600)
                    && (request.resource.data.get('workoutSnapshot', null) == null
                        || (request.resource.data.workoutSnapshot is map
                            && request.resource.data.workoutSnapshot.get('exercises', null) is list
                            && request.resource.data.workoutSnapshot.exercises.size() <= 30));

      // Delete: only the original author.
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.authorUid;

      // One reaction per user and post: the reaction document id IS the
      // reactor uid. `reactionCounts` on the parent is maintained exclusively
      // by the Admin SDK Cloud Function and is therefore never writable here.
      match /reactions/{reactorUid} {
        function reactionPost() {
          return get(/databases/$(database)/documents/posts/$(postId)).data;
        }

        function reactionPostReadable() {
          let post = reactionPost();
          return post.privacy == 'public'
                 || request.auth.uid == post.authorUid
                 || (post.privacy == 'friends'
                     && postFollowerAccepted(post.authorUid))
                 || (post.privacy == 'gym'
                     && postSameGym(post.get('authorGymId', null)));
        }

        function reactionPayloadOk() {
          return request.resource.data.keys().hasOnly(['type', 'createdAt'])
                 && request.resource.data.type in ['like', 'fire', 'clap']
                 && request.resource.data.createdAt is timestamp;
        }

        allow read: if request.auth != null
                    && reactionPostReadable();

        allow create, update: if request.auth != null
                              && request.auth.uid == reactorUid
                              && reactionPostReadable()
                              && reactionPayloadOk();

        allow delete: if request.auth != null
                      && request.auth.uid == reactorUid;
      }
    }

    // Public identity documents — one per user, public-readable by any
    // authenticated user, writable only by the owner. Contains ONLY the
    // known fields (uid, displayName, displayNameLowercase, avatarUrl,
    // gymId, gymName, workoutsCount, racha, rachaUpdatedAt, followersCount,
    // followingCount, sharedTemplatesWithAthletes, rankingOptIn,
    // isProfilePublic, lifetimeVolumeKg, bestSquatKg, bestBenchKg,
    // bestDeadliftKg).
    // REQ-UPP-014, REQ-UPP-015. GAP-1, GAP-2, GAP-3 from design Section C.
    //
    // rankings-integrity Phase 2 (PR#2) hardening — AD-3, AD-4, AD-6, AD-8:
    //   - Field allowlist via keys().hasOnly() (was previously unchecked).
    //   - gymId cross-doc pin against users/{uid}.gymId (an athlete cannot
    //     self-assign to a gym they don't attend).
    //   - The 4 ranking-metric fields (lifetimeVolumeKg, bestSquatKg,
    //     bestBenchKg, bestDeadliftKg) become CF-write-only: a client update
    //     may only re-assert the currently stored value, EXCEPT on the
    //     rankingOptIn true->false disable transition, where
    //     clearRankingMetrics is explicitly allowed to reset them to their
    //     fixed defaults (spec gym-rankings: Opt-In Disable — Unchanged,
    //     Client-Initiated — "deflating one's own stats is not a forgery
    //     vector"). The server-side recompute trigger
    //     (functions/src/ranking-aggregate.ts) writes via the Admin SDK,
    //     which bypasses rule evaluation entirely — no rule path here
    //     "allows" that write, it is simply not subject to rules.
    //   - Type/range validation (AD-8): best*Kg <= 1000, lifetimeVolumeKg
    //     <= 100_000_000 when present; rankingOptIn must be bool when
    //     present. Bounds are defense-in-depth — the trigger is the real
    //     authority on the true value.
    match /userPublicProfiles/{uid} {
      // Any authenticated user can read (get or list). Enables prefix-range
      // search queries from searchByDisplayName. REQ-UPP-014. Unchanged by
      // this hardening pass (Read Access Unchanged).
      //
      // ⚠️ `isProfilePublic` NO se consulta acá, y es deliberado
      // (QA-SEC-011, #778 — decidido como Opción B). El flag existe en el doc
      // y las reglas saben leerlo (`follows` create lo hace en :1350 para el
      // auto-accept), pero NO gobierna lecturas: un perfil con
      // `isProfilePublic: false` entrega igual racha, workoutsCount,
      // contadores, volumen y PRs a cualquier autenticado. Medido contra el
      // emulador en `docs/security.md` §4.9.
      //
      // El motivo no es descuido: las reglas de Firestore **no filtran por
      // campo en las lecturas** —son todo-o-nada por documento—, así que
      // "header de identidad público, métricas gateadas" no se puede escribir
      // acá. Exige partir el documento en dos colecciones, con dual-write,
      // backfill y ~20 consumidores a tocar, más una decisión sobre los
      // rankings por gym, que son opt-in explícito sobre estas mismas
      // métricas. Eso es feature con épico propio, no un ajuste de regla.
      //
      // Lo que se hizo en #778 fue cerrar la brecha por el otro lado: el copy
      // y las dartdocs ya no prometen un gate de contenido. Si algún día se
      // implementa el gate de verdad, este comentario es el lugar donde
      // empieza. NO agregues acá un `isProfilePublic == true` creyendo que
      // alcanza: rompe `searchByDisplayName` (:894) y los rankings, y sigue
      // sin poder esconder campos sueltos.
      allow read: if request.auth != null;

      // Only the owner can create their own doc; uid in body must match doc
      // id. Field allowlist applies from create onward. gymId, when
      // present, must match the athlete's own private gymId (AD-4). The 4
      // ranking-metric fields must be absent or at their fixed defaults —
      // a create cannot seed forged values (AD-3).
      //
      // ⚠️  getAfter(), not get(): UserRepository.update dual-writes
      // users/{uid} and userPublicProfiles/{uid} in a SINGLE WriteBatch
      // (e.g. profile_gym_screen's gym-change flow, RankingOptInController's
      // gymId denormalization). Firestore rules' get() only ever sees the
      // PRE-batch committed state — it cannot observe another write in the
      // same batch — so pinning against get(users/{uid}) would deny every
      // real same-batch gym change (the private doc's new value isn't
      // visible yet when this doc's rule evaluates). getAfter() reads the
      // POST-batch value instead, which is exactly what a same-batch
      // dual-write needs to validate against. Note: users/{uid}.gymId is
      // itself unrestricted/self-reported (see match /users/{uid} above —
      // no gym-membership authority exists in this system), so this pin's
      // real guarantee is narrower than "proves gym attendance": it only
      // enforces that the PUBLIC gymId is consistent with whatever the
      // athlete's OWN private doc claims, closing the "show gym B publicly
      // while privately tied to gym A" inconsistency — not a physical-
      // attendance proof, which no rule can provide given gymId is
      // self-reported everywhere.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && request.resource.data.keys().hasOnly([
                         'uid', 'displayName', 'displayNameLowercase',
                         'avatarUrl', 'gymId', 'gymName', 'workoutsCount',
                         'racha', 'rachaUpdatedAt', 'followersCount',
                         'followingCount',
                         'sharedTemplatesWithAthletes', 'rankingOptIn',
                         'isProfilePublic',
                         'lifetimeVolumeKg', 'bestSquatKg', 'bestBenchKg',
                         'bestDeadliftKg'
                       ])
                    // #552: freshness stamp for `racha`, always derived by
                    // UserPublicProfileRepository.updateCounters (server
                    // timestamp) — timestamp when present.
                    && (!('rachaUpdatedAt' in request.resource.data)
                        || request.resource.data.rachaUpdatedAt is timestamp)
                    // #563: Instagram-style privacy flag, flipped by
                    // UserPublicProfileRepository.setProfilePublic — bool
                    // when present. Docs without the field read as public
                    // (`.get('isProfilePublic', true)` in follows).
                    && (!('isProfilePublic' in request.resource.data)
                        || request.resource.data.isProfilePublic is bool)
                    && (!('gymId' in request.resource.data)
                        || request.resource.data.gymId
                           == getAfter(/databases/$(database)/documents/users/$(uid)).data.gymId)
                    && (!('lifetimeVolumeKg' in request.resource.data)
                        || request.resource.data.lifetimeVolumeKg == 0)
                    && (!('bestSquatKg' in request.resource.data)
                        || request.resource.data.bestSquatKg == null)
                    && (!('bestBenchKg' in request.resource.data)
                        || request.resource.data.bestBenchKg == null)
                    && (!('bestDeadliftKg' in request.resource.data)
                        || request.resource.data.bestDeadliftKg == null)
                    && (!('rankingOptIn' in request.resource.data)
                        || request.resource.data.rankingOptIn is bool);

      // Only the owner can update; uid in body must not change (immutable).
      // Field allowlist, gymId pin, CF-write-only metric pins, and
      // type/range validation all apply here.
      //
      // ⚠️  COUPLING WARNING — hasOnly field list below:
      // This list MUST contain every field a userPublicProfiles doc stores.
      // If you add a field to UserPublicProfile, you MUST add it here too —
      // otherwise ALL profile updates will fail with permission-denied.
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.keys().hasOnly([
                         'uid', 'displayName', 'displayNameLowercase',
                         'avatarUrl', 'gymId', 'gymName', 'workoutsCount',
                         'racha', 'rachaUpdatedAt', 'followersCount',
                         'followingCount',
                         'sharedTemplatesWithAthletes', 'rankingOptIn',
                         'isProfilePublic',
                         'lifetimeVolumeKg', 'bestSquatKg', 'bestBenchKg',
                         'bestDeadliftKg'
                       ])
                    // #552: freshness stamp for `racha` — timestamp when
                    // present (always serverTimestamp() derived in
                    // UserPublicProfileRepository.updateCounters).
                    && (!('rachaUpdatedAt' in request.resource.data)
                        || request.resource.data.rachaUpdatedAt is timestamp)
                    // #563: Instagram-style privacy flag — bool when
                    // present. See the create-branch comment above.
                    && (!('isProfilePublic' in request.resource.data)
                        || request.resource.data.isProfilePublic is bool)
                    // gymId Integrity (AD-4): when the write touches gymId,
                    // it must equal the athlete's own private gymId.
                    // getAfter(), not get() — see the create-branch comment
                    // above: UserRepository.update dual-writes users/{uid}
                    // and userPublicProfiles/{uid} in the SAME WriteBatch,
                    // and get() cannot see a sibling write from that same
                    // batch (it only sees pre-batch state). getAfter() reads
                    // the post-batch value, so a same-batch gym change
                    // (profile_gym_screen, RankingOptInController) is
                    // correctly validated instead of being denied by a
                    // stale pre-batch comparison. A missing/absent
                    // users/{uid} doc makes getAfter() fail the whole
                    // expression (denied) — onboarding always writes
                    // users/{uid} in the same or an earlier batch, so this
                    // is safe in the normal write order.
                    && (!('gymId' in request.resource.data)
                        || request.resource.data.gymId
                           == getAfter(/databases/$(database)/documents/users/$(uid)).data.gymId)
                    // rankingOptIn: bool when present (Type Validation).
                    && (!('rankingOptIn' in request.resource.data)
                        || request.resource.data.rankingOptIn is bool)
                    // CF-Write-Only Ranking Metrics (AD-3) + Opt-In Disable
                    // exception (gym-rankings spec, AD-6 resolution): each
                    // metric may only (a) be absent from the write, (b)
                    // equal its currently stored value, or (c) be reset to
                    // its fixed default IF this write is also flipping
                    // rankingOptIn from true to false — the exact shape of
                    // UserPublicProfileRepository.clearRankingMetrics. Any
                    // other value is denied — this is not a laundering path
                    // for a forged metric via a disable/re-enable round
                    // trip, since the disable-branch only tolerates the
                    // fixed default, never an arbitrary value.
                    && (!('lifetimeVolumeKg' in request.resource.data)
                        || request.resource.data.lifetimeVolumeKg
                           == resource.data.get('lifetimeVolumeKg', 0)
                        || (request.resource.data.get('rankingOptIn', true) == false
                            && resource.data.get('rankingOptIn', false) == true
                            && request.resource.data.lifetimeVolumeKg == 0))
                    && (!('bestSquatKg' in request.resource.data)
                        || request.resource.data.bestSquatKg
                           == resource.data.get('bestSquatKg', null)
                        || (request.resource.data.get('rankingOptIn', true) == false
                            && resource.data.get('rankingOptIn', false) == true
                            && request.resource.data.bestSquatKg == null))
                    && (!('bestBenchKg' in request.resource.data)
                        || request.resource.data.bestBenchKg
                           == resource.data.get('bestBenchKg', null)
                        || (request.resource.data.get('rankingOptIn', true) == false
                            && resource.data.get('rankingOptIn', false) == true
                            && request.resource.data.bestBenchKg == null))
                    && (!('bestDeadliftKg' in request.resource.data)
                        || request.resource.data.bestDeadliftKg
                           == resource.data.get('bestDeadliftKg', null)
                        || (request.resource.data.get('rankingOptIn', true) == false
                            && resource.data.get('rankingOptIn', false) == true
                            && request.resource.data.bestDeadliftKg == null))
                    // Type/Range Validation (AD-8): defense-in-depth bounds
                    // when a metric is present AND is a fresh (non-pinned,
                    // non-disable-reset) numeric write would already have
                    // been rejected above unless it equals the stored value
                    // or the fixed default — both of which are always within
                    // bounds. These checks guard the stored/reasserted value
                    // itself is well-typed, protecting against a corrupt
                    // stored value some day being re-asserted forever.
                    && (!('lifetimeVolumeKg' in request.resource.data)
                        || (request.resource.data.lifetimeVolumeKg is number
                            && request.resource.data.lifetimeVolumeKg >= 0
                            && request.resource.data.lifetimeVolumeKg <= 100000000))
                    && (!('bestSquatKg' in request.resource.data)
                        || request.resource.data.bestSquatKg == null
                        || (request.resource.data.bestSquatKg is number
                            && request.resource.data.bestSquatKg >= 0
                            && request.resource.data.bestSquatKg <= 1000))
                    && (!('bestBenchKg' in request.resource.data)
                        || request.resource.data.bestBenchKg == null
                        || (request.resource.data.bestBenchKg is number
                            && request.resource.data.bestBenchKg >= 0
                            && request.resource.data.bestBenchKg <= 1000))
                    && (!('bestDeadliftKg' in request.resource.data)
                        || request.resource.data.bestDeadliftKg == null
                        || (request.resource.data.bestDeadliftKg is number
                            && request.resource.data.bestDeadliftKg >= 0
                            && request.resource.data.bestDeadliftKg <= 1000));

      // Deletion denied — managed exclusively through WriteBatch from
      // server-side operations (backfill, account deletion Cloud Function).
      allow delete: if false;
    }

    // Trainer public identity documents — readable by any authenticated user,
    // writable only by the owner (always written via UserRepository dual-write).
    // REQ-COACH-DISC-DATA-008, REQ-COACH-DISC-DATA-009.
    //
    // rules-hardening Slice B (AD-3) — averageRating/reviewCount Are
    // CF-Write-Only: these two fields are derived aggregates written by the
    // `reviewAggregate` Cloud Function via the Admin SDK (which bypasses
    // rules entirely — no rule path here "allows" that write). A client
    // write (create or update) may only (a) omit the fields, or (b) on
    // update, re-assert the exact currently-stored value. Any other value —
    // including seeding a value at create time — is denied. Mirrors the
    // userPublicProfiles CF-write-only ranking-metric idiom
    // (firestore.rules:434-468, `.get(field, null)` null-safe comparison)
    // verbatim, without the opt-in-disable exception clause (no analogous
    // disable flow exists for reviews).
    //
    // #388 extends the same pin to `athleteCount`: derived aggregate (count
    // of active trainer_links) written exclusively by the `linkAggregate`
    // Cloud Function. Without the pin a trainer could forge their own
    // student count on the discovery sales surface.
    //
    // Deliberately NO keys().hasOnly() allowlist here (AD-3 divergence from
    // the trainer-reviews spec's "Out-of-allowlist field" scenario — see
    // tasks.md 2.7): TrainerPublicProfileRepository's write path is a
    // partial merge with a large, evolving discovery-field set, making
    // hasOnly a high-risk coupling trap for near-zero security value (those
    // fields are self-attested, not a trust boundary).
    match /trainerPublicProfiles/{uid} {
      // Any authenticated user can read (SCENARIO-416).
      allow read: if request.auth != null;

      // Only the owner can create their own doc; uid in body must match doc id.
      // (SCENARIO-418). averageRating/reviewCount must be absent or null —
      // a create cannot seed a forged starting value (AD-3).
      // QA-SEC-013 (#780): además del ownership, exige rol `trainer`. Slice C
      // (AD-1 opción b) había puesto este mismo disyunto en cinco colecciones
      // y las tres que publican al PF quedaron afuera. Medido contra el
      // emulador: una cuenta `role: 'athlete'` creaba su propio
      // `trainerPublicProfiles/{self}` y **aparecía en el descubrimiento** —
      // la sonda corrió la misma query que
      // `TrainerPublicProfileRepository.listAll()`
      // (`orderBy('displayNameLowercase').limit(50)`) y el doc forjado volvía
      // PRIMERO, porque el atacante elige el string por el que se ordena.
      // Ver `docs/security.md` §4.9.
      //
      // Es un gate de INTEGRIDAD, no de confidencialidad: no filtra datos de
      // terceros, evita que se ensucie el directorio comercial, que es la
      // superficie de venta del producto. Los campos del perfil siguen siendo
      // self-attested a propósito (AD-3) — esto decide **quién puede existir**
      // en el directorio, no qué dice su bio.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'
                    && request.resource.data.get('averageRating', null) == null
                    && request.resource.data.get('reviewCount', null) == null
                    && request.resource.data.get('athleteCount', null) == null;

      // Only the owner can update; uid in body must not change (SCENARIO-418).
      // averageRating/reviewCount must be absent or unchanged from the
      // stored value (AD-3) — closes the raw set(merge)/update forgery path.
      // El gate de rol va también en `update`, y no es simetría cosmética: sin
      // él, un doc forjado ANTES de que existiera este gate seguiría siendo
      // editable por su dueño athlete para siempre. Cerrar sólo `create` deja
      // vivo lo que ya se coló.
      //
      // ⚠️ DESPLIEGUE: esto congela la edición de cualquier
      // `trainerPublicProfiles` cuyo dueño NO tenga `users/{uid}.role ==
      // 'trainer'`. Para los forjados es exactamente lo que se busca; para un
      // PF legítimo cuyo doc privado tuviera el rol mal sería una regresión.
      // Antes de mergear se corre `scripts/audit_trainer_profiles.mjs`, que
      // cruza las dos colecciones y lista los huérfanos.
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == resource.data.uid
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'
                    && request.resource.data.get('averageRating', null) == resource.data.get('averageRating', null)
                    && request.resource.data.get('reviewCount', null) == resource.data.get('reviewCount', null)
                    && request.resource.data.get('athleteCount', null) == resource.data.get('athleteCount', null);

      // Delete denied — managed exclusively via privileged server-side operations.
      allow delete: if false;
    }

    // Gym catalog — Fase 6 Etapa 0 (multi-location).
    //
    // Cualquier user autenticado puede leer (lo necesitan athletes para
    // mostrar el nombre del gym cuando ven una `TrainerLocation`, y trainers
    // para elegirlo en el form de edición de perfil).
    //
    // Solo PFs (role == trainer) pueden crear via self-service. El doc tiene
    // que setear `source: 'self-service'` y `createdBy: request.auth.uid` —
    // si no, denied. Update/delete denegado del cliente — moderación va por
    // Console o un Cloud Function privilegiado en el futuro.
    //
    // gym-google-places (sdd change) — PLAN B (client-side resolve): the
    // original design routed athlete-originated `google-places` docs through
    // a `resolveGymPlace` Cloud Function (Admin SDK, bypasses rules). That CF
    // CANNOT be deployed — GCP project `treino-dev` sits under org
    // `code-assurance.com`, whose Domain-Restricted-Sharing policy blocks a
    // publicly-invokable (`allUsers`) Cloud Function. The CF is SHELVED
    // (kept in functions/src/places-search.ts, not exported from index.ts).
    // Resolution now happens CLIENT-SIDE (ResolveGymPlaceService,
    // lib/features/gyms/data/resolve_gym_place_service.dart), so an
    // authenticated athlete's client now writes `gyms/{placeId}` directly —
    // this ADDS a second `allow create` branch below for that path. The
    // shape is intentionally narrow: `source` must be exactly
    // 'google-places', `id` must equal the doc id (placeId), and no
    // `createdBy`/trainer-role check applies (any authenticated user, not
    // just trainers, can resolve a gym place). The pre-existing
    // self-service branch (trainer-only) is unchanged.
    match /gyms/{gymId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'
                    && request.resource.data.source == 'self-service'
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.keys().hasAll(['name', 'lat', 'lng', 'geohash', 'source', 'createdBy', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    // QA-SEC-003: geographic range guard (mirrors the
                    // google-places create branch) — coordinates must be valid.
                    && request.resource.data.lat is number
                    && request.resource.data.lat >= -90
                    && request.resource.data.lat <= 90
                    && request.resource.data.lng is number
                    && request.resource.data.lng >= -180
                    && request.resource.data.lng <= 180
                    && request.resource.data.geohash is string;

      allow create: if request.auth != null
                    && request.resource.data.source == 'google-places'
                    && request.resource.data.id == gymId
                    && request.resource.data.keys().hasAll(['id', 'name', 'lat', 'lng', 'source'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    // QA-SEC-003: geographic range guard — a resolved place must
                    // land on Earth. Blocks garbage coordinates polluting the
                    // world-readable catalog / distance math.
                    && request.resource.data.lat is number
                    && request.resource.data.lat >= -90
                    && request.resource.data.lat <= 90
                    && request.resource.data.lng is number
                    && request.resource.data.lng >= -180
                    && request.resource.data.lng <= 180;

      // Client-side resolve can race two concurrent selectors of the same
      // never-before-seen placeId; the read-through cache in
      // ResolveGymPlaceService only calls upsert() on a cache miss, so the
      // ONLY legitimate update is that race re-upserting the SAME Place
      // Details for an already-resolved placeId.
      //
      // QA-SEC-003: `gyms` is world-readable and drives gym association and
      // leaderboards, so the resolved identity fields MUST be pinned to their
      // existing values. The previous type-only check let ANY authenticated
      // user overwrite name/lat/lng of any existing gym — catalog vandalism.
      // Pinning name/lat/lng/source/id equal-to-existing still lets the
      // same-shape race write through (identical values are a no-op match)
      // while denying every value change. Mirrors the field-pin idiom used by
      // userPublicProfiles ranking metrics and trainerPublicProfiles
      // averageRating/reviewCount above.
      allow update: if request.auth != null
                    && resource.data.source == 'google-places'
                    && request.resource.data.source == resource.data.source
                    && request.resource.data.id == gymId
                    && request.resource.data.name == resource.data.name
                    && request.resource.data.lat == resource.data.lat
                    && request.resource.data.lng == resource.data.lng;

      allow delete: if false;
    }

    match /friendships/{friendshipId} {
      // FREEZE (M-03b, ADR-FOLLOW-015, REQ-FOLLOW-017) — change `follow-model`.
      //
      // `friendships` migra a `follows` (arista dirigida). El script de
      // migración SOLO crea (`batch.create()`, nunca pisa ni borra), así que
      // un borrado de una friendship ya migrada, ocurrido con una build vieja
      // DESPUÉS de la migración, no se propagaba: las dos aristas migradas
      // sobrevivían al origen y el usuario creía haber revocado el acceso sin
      // haberlo hecho — phantom access (LD-04), la peor falla posible en un
      // cambio de privacidad.
      //
      // El freeze se adelanta a ANTES de la migración (M-03b, antes de M-04)
      // en vez de ir pegado al flip del gate de lectura (M-07, la versión
      // anterior de este plan): cerrar la ventana de raíz, en vez de
      // detectarla con reconciliación de borrados. Deploy de este bloque es
      // manual — 2.8b — y tiene que preceder al primer `--apply` de la
      // migración.
      //
      // `create`/`update`/`delete` pasan a `if false`. `read` se CONSERVA sin
      // tocar (ADR-FOLLOW-012): hace falta para el rollback — la
      // reversibilidad la da el dato intacto, no el código — y para que una
      // build vieja que solo lee su lista de amigos no se rompa.
      //
      // Read: only members of the friendship — OR doc does not exist AND the
      // caller is one of the two uids the doc id encodes. El `resource == null`
      // hace falta para que `getByPair()` resuelva "todavía no hay amistad"
      // entre dos personas que nunca interactuaron (p. ej. visitar un perfil
      // público recién creado) sin tirar permission-denied. Pre-existente
      // desde el PR #28 (REQ-PFM-010).
      //
      // ⚠️  QA-SEC-010 — el disyunto está ACOTADO al par. La versión anterior
      // decía "returns empty snapshot without leaking data", y eso medía
      // FALSO: el doc id es el par ordenado `{uidA}_{uidB}` y los dos padrones
      // de uid son enumerables (`userPublicProfiles` y `trainerPublicProfiles`
      // son list-ables por cualquier autenticado), así que armar el par exacto
      // no cuesta nada. El segundo check bloquea el CONTENIDO, no la PREGUNTA:
      // "no existe" volvía como snapshot vacío y "existe y no es tuyo" como
      // PERMISSION_DENIED, y esa diferencia ES la respuesta. Con el acote, un
      // tercero recibe PERMISSION_DENIED en los DOS estados y no distingue uno
      // del otro.
      //
      // El acote usa `split('_')`, que es seguro sólo mientras los uid de
      // Firebase Auth sigan siendo alfanuméricos sin guión bajo (docs/security.md
      // §1.7). Es el mismo idiom que ya usa `storage.rules:athleteFiles`.
      allow read: if request.auth != null
                  && ((resource == null
                       && request.auth.uid in friendshipId.split('_'))
                      || request.auth.uid in resource.data.members);

      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Grafo social DIRIGIDO — reemplaza a `friendships` (change `follow-model`).
    //
    // Doc id = '{followerUid}_{followeeUid}', SIN ordenar. Que el id sea
    // determinístico a partir de la dirección es lo que permite que el gate de
    // lectura de posts resuelva "¿el lector sigue al autor?" con un lookup
    // directo por doc id — sin queries, sin índices y con un solo get().
    //
    // ADITIVO: en este punto de la migración (M-03) nada lo lee todavía. El
    // flip del gate de posts ocurre en un PR posterior, y nunca se hace OR
    // entre `friendships` y `follows`: un OR durante la transición significaría
    // que dejar de seguir no revoca el acceso, porque el doc legacy `accepted`
    // seguiría resolviendo true. Es la peor falla posible en un cambio de
    // privacidad, así que se prohíbe por diseño.
    match /follows/{followId} {
      // `resource == null` permite preguntar "¿lo sigo?" y que la respuesta
      // legítima "no" resuelva en vez de tirar permission-denied.
      //
      // ⚠️  QA-SEC-010 — ese disyunto está ACOTADO a los dos uid que el doc id
      // encodea. Sin el acote era un oráculo: `{follower}_{followee}` es
      // determinístico y los padrones de uid son enumerables, así que un
      // tercero preguntaba por un par cualquiera y leía la respuesta en la
      // FORMA de la respuesta — snapshot vacío = "no existe", PERMISSION_DENIED
      // = "existe y está `pending`". O sea: quién le mandó solicitud a quién y
      // todavía no fue aceptada, que es exactamente el estado de las cuentas
      // privadas. Con el acote los dos estados devuelven lo mismo a un tercero.
      //
      // Lo que NO cambia: una arista `accepted` la sigue leyendo cualquiera
      // (último disyunto), que es lo que abre las listas de seguidores/seguidos
      // públicas. El acote sólo tapa la diferencia entre "no existe" y "existe
      // pendiente".
      //
      // ⚠️ LAS RULES NO SE EVALÚAN DOCUMENTO POR DOCUMENTO EN UNA QUERY.
      //
      // Firestore analiza la query contra la regla y exige poder PROBAR que la
      // regla se cumple usando SOLO las cláusulas `where`, sin leer un solo
      // documento. Un campo que el `where` no menciona queda indefinido, y
      // referenciarlo tira `Property X is undefined on object. for 'list'` —
      // la query se rechaza entera aunque todos los documentos reales
      // cumplieran la regla.
      //
      // Por eso hay cuatro disyunciones que a nivel de documento son
      // redundantes entre sí (`members == [followerUid, followeeUid]` está
      // garantizado por el `create` de abajo): existen para que el planner
      // pueda probar la regla desde el `where` de CADA query que la app hace.
      //
      //   query                                    disyunción que la prueba
      //   ─────────────────────────────────────    ────────────────────────
      //   doc id (`getEdge`/`watchEdge`)           members
      //   members array-contains uid (`allOf`)     members
      //   followerUid == uid  (`followingOf`)      followerUid
      //   followeeUid == uid  (`pendingReceivedFor`) followeeUid
      //   status == 'accepted' de un tercero       status  ← listas ajenas
      //
      // Las tres primeras NO son nuevas funcionalmente: sin ellas
      // `followingOf` y `pendingReceivedFor` quedaban denegadas —el feed
      // SEGUIDORES y el inbox de solicitudes rotos— porque la regla vieja
      // sólo nombraba `members`. El test de `read` cubría únicamente lecturas
      // por doc id, así que el agujero pasó verde.
      //
      // `error || true == true` en el lenguaje de rules: las disyunciones que
      // el planner no puede resolver dan error y NO envenenan el OR mientras
      // alguna otra sea probablemente verdadera.
      //
      // La última disyunción (`status == 'accepted'`) es la que abre las
      // listas de SEGUIDORES/SEGUIDOS de cualquiera a cualquier autenticado.
      // Llega hasta ahí y ni un paso más: una solicitud `pending` sigue
      // siendo asunto de los dos involucrados, y una query sin el filtro de
      // status no se puede probar, así que se cae entera en vez de filtrar.
      allow read: if request.auth != null
                  && ((resource == null
                       && request.auth.uid in followId.split('_'))
                      || request.auth.uid in resource.data.members
                      || request.auth.uid == resource.data.followerUid
                      || request.auth.uid == resource.data.followeeUid
                      || resource.data.status == 'accepted');

      // Create: solo el follower crea su propia arista.
      //
      // El status puede ser 'accepted' SOLO si el destinatario tiene el perfil
      // público (auto-accept estilo Instagram). Los perfiles anteriores a la
      // feature de privacidad no tienen el campo: `.get(..., true)` los trata
      // como públicos, porque tratarlos como privados le rompería el
      // auto-accept a cuentas que nunca pidieron serlo.
      //
      // El get() apunta a un uid CONOCIDO (`followeeUid`). En `friendships`
      // había que probar uidA y si no uidB: de ≤2 get() a exactamente 1.
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.followerUid
                    && followId == request.resource.data.followerUid + '_'
                                   + request.resource.data.followeeUid
                    && request.resource.data.followerUid
                       != request.resource.data.followeeUid
                    && request.resource.data.id == followId
                    && request.resource.data.keys().hasOnly(
                         ['id', 'followerUid', 'followeeUid', 'status',
                          'members', 'createdAt'])
                    && request.resource.data.members ==
                         [request.resource.data.followerUid,
                          request.resource.data.followeeUid]
                    && request.resource.data.createdAt is timestamp
                    && (
                      request.resource.data.status == 'pending'
                      || (request.resource.data.status == 'accepted'
                          && get(/databases/$(database)/documents/userPublicProfiles/$(request.resource.data.followeeUid))
                               .data.get('isProfilePublic', true) == true)
                    );

      // Update: SOLO el followee, y SOLO para aceptar (pending → accepted).
      //
      // El self-accept deja de ser un check que alguien puede borrar sin querer
      // y pasa a ser estructural: solo el followee puede escribir, y el doc id
      // fija quién es cada uno.
      //
      // Lleva la MISMA allowlist que el create y pinea `id`. No es simetría
      // cosmética: el update es la única escritura que hace un usuario distinto
      // del creador del doc. Sin hasOnly, aceptar una solicitud sería una vía
      // para inyectar campos que las rules no validan; sin el pin de `id`, para
      // desincronizar `id` del doc id. Los dos productos violan la verificación
      // de la migración, o sea que la escritura legítima podría fabricar un
      // documento que el propio change rechaza después.
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.followeeUid
                    && request.resource.data.keys().hasOnly(
                         ['id', 'followerUid', 'followeeUid', 'status',
                          'members', 'createdAt'])
                    && request.resource.data.id == followId
                    && resource.data.status == 'pending'
                    && request.resource.data.status == 'accepted'
                    && request.resource.data.followerUid
                       == resource.data.followerUid
                    && request.resource.data.followeeUid
                       == resource.data.followeeUid
                    && request.resource.data.members == resource.data.members
                    && request.resource.data.createdAt
                       == resource.data.createdAt;

      // Delete: cualquiera de los dos miembros. Es la misma operación para
      // dejar de seguir, cancelar una solicitud enviada y rechazar una
      // recibida — y también lo que va a habilitar "quitar seguidor".
      // Borra UNA dirección: la inversa es otro documento y no se toca.
      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.members;
    }

    // Chat 1-1 entre PF y athlete (Fase 5 Etapa 5).
    // Doc id determinístico: sortedUids.join('_'). Reglas:
    //   - read: solo members del chat (o doc inexistente para tolerar reads
    //     desde getOrCreate antes del create).
    //   - create: caller en members, members.size()==2, members ordenados
    //     ascendentemente, y chatId == members.join('_').
    //   - update: caller en members. members/createdAt inmutables.
    //   - delete: denied.
    match /chats/{chatId} {
      // QA-CHAT-004: a chat may only be opened between two users who have a real
      // relationship. Sin este gate cualquier autenticado podía abrir un chat
      // con —y escribirle a— cualquiera.
      //
      // REQ-FOLLOW-012 / LD-08 / ADR-FOLLOW-005 — la rama social pasó a ser
      // DIRECCIONAL: abrir un chat es poder mandar el primer mensaje, así que
      // lo que habilita es que el DESTINATARIO siga a quien lo abre
      // (`follows/{otro}_{yo}` aceptada). Reemplaza al `exists`+`get` sobre
      // `friendships/{chatId}`, que era simétrico por construcción — el doc id
      // de `friendships` es el par ordenado, o sea el MISMO documento para las
      // dos direcciones.
      //
      // Costo sin cambios: un lookup direccional cuesta exactamente lo mismo
      // (`exists`+`get` = 2) que el simétrico que reemplaza. El peor caso
      // (social falla → se evalúa trainer) sigue en ≤6 sobre el techo de 10.
      //
      // `members[0] < members[1]` y `chatId == members[0]+'_'+members[1]` ya los
      // garantiza el propio `allow create` de abajo, y `members` es inmutable en
      // el `update`, así que derivar "el otro" del array es exacto y no hace
      // falta partir el chatId ni agregar ningún dato.
      //
      // La rama trainer_link queda SIN CAMBIOS: el link se verifica acá (no se
      // confía), y SEC-002 garantiza que un link activo fue aceptado por el
      // trainer, así que ninguna de las dos partes puede fraguar uno.
      //
      // ⚠ LAS DOS RAMAS SON EXCLUYENTES, NO UN `||` — y eso es de SEGURIDAD, no
      // de estilo. Con `followAccepted(...) || ('linkId' in data && ...)`, un
      // chat social hacía true la primera rama y el `linkId` del payload
      // **nunca se validaba**: quedaba persistido un linkId inventado. Como
      // `senderMayPost` (abajo) escapa por la mera PRESENCIA de la clave, eso
      // le regalaba al que lo plantó escritura permanente, sobreviviendo al
      // unfollow. O sea: el gate direccional entero quedaba decorativo, que es
      // exactamente lo que REQ-FOLLOW-012 dice que no puede pasar.
      //
      // Con el ternario, la INVARIANTE que sostiene a `senderMayPost` es:
      // **un doc de chat sólo lleva `linkId` si nombra un link válido.** Se
      // paga en la escritura (acá y en el pin del `update`), no en cada
      // mensaje, así que el chat del Coach sigue costando 1 sola llamada.
      //
      // Efecto lateral bueno: el peor caso de `chats/create` baja de ≤6 a 4,
      // porque ya no se evalúan las dos ramas en cadena.
      //
      // ── TERCERA RAMA: chat de PRE-CONSULTA (#637) ────────────────────────
      //
      // Problema: la única forma de dirigirle la palabra a un PF era pedirle un
      // vínculo formal, y `TrainerContactCtaStub` bloquea ese pedido si el
      // atleta ya tiene UN vínculo pending/active con CUALQUIER PF. O sea que
      // el producto obligaba a elegir antes de poder preguntar: pedirle vínculo
      // al primer coach dejaba a los otros dos inalcanzables.
      //
      // La rama social NO sirve para este caso y no es cuestión de reusarla:
      // es direccional a propósito (REQ-FOLLOW-012 / ADR-FOLLOW-005) y la
      // dirección que habilita es la contraria — exigiría que el PF siga al
      // atleta ANTES de que el atleta pueda preguntarle. Nadie hace eso.
      //
      // Por eso una rama propia, y —igual que las otras dos— EXCLUYENTE: es un
      // ternario anidado, no un `|| esConsulta` al final. Un `||` reabriría
      // exactamente el agujero que documenta el bloque de arriba: un payload
      // con `kind: 'inquiry'` haría true la disyunción y el `linkId` del mismo
      // payload no se validaría nunca.
      //
      // Qué habilita la rama, y por qué esa condición:
      //
      //   1. `users/{otro}.role == 'trainer'` — el destinatario es un PF DE
      //      VERDAD. Es el ÚNICO hecho no auto-declarable del sistema: el rol
      //      es intrínseco (AGENTS.md regla 3), el signup público fuerza
      //      'athlete' y el update lo pinea inmutable (QA-SEC-001), así que
      //      sólo el Admin SDK acuña un trainer.
      //
      //   2. `exists(trainerPublicProfiles/{otro})` — ese PF PUBLICÓ su perfil
      //      de discovery, o sea que está en el mapa y en la búsqueda. Es la
      //      señal de consentimiento: un PF que nunca se publicó no aparece en
      //      ninguna superficie desde donde se pueda consultar, y no queremos
      //      que sea alcanzable igual por doc id.
      //
      //   ⚠ El punto 2 NO alcanza solo, y por eso están los dos: el `create` de
      //   `trainerPublicProfiles` (arriba, ~línea 995) valida dueño y forma
      //   pero NO chequea rol — cualquier autenticado puede crearse el suyo.
      //   Gatear sólo por ese doc sería confiar en un PF auto-declarado, que es
      //   justo lo que el issue pide no hacer.
      //
      //   El `exists()` del punto 2 es REDUNDANTE y está a propósito: la
      //   verificación por mutación lo confirma (sacarlo no pone rojo ningún
      //   test, porque el `get()` de abajo sobre un doc inexistente devuelve
      //   null y `.data` revienta → deny). Se queda por la misma razón que en
      //   la rama Coach: que la condición se lea, y no dependa de un error de
      //   evaluación. Cuesta 1 llamada y el peor caso sigue siendo la rama
      //   Coach, así que no se paga nada.
      //
      //   3. `acceptsInquiries != false` — kill switch del lado del PF. Esta
      //      rama abre una superficie de spam NUEVA (hoy nadie le escribe a un
      //      PF sin que el PF haya aceptado un vínculo), así que el PF tiene
      //      que poder cerrarla. Default `true` porque los perfiles existentes
      //      no tienen el campo y la feature existe para que sean contactables.
      //      El `update` de `trainerPublicProfiles` es owner-only sin
      //      allowlist, así que el PF ya puede escribirlo sin regla nueva.
      //
      // DIRECCIONALIDAD GRATIS: la rama mira al OTRO, nunca a quien escribe.
      // Un PF no puede usarla para escribirle en frío a un atleta — ahí `other`
      // es el atleta, `role != 'trainer'`, denegado. La vía nueva es
      // atleta→PF (o PF→PF), nunca PF→atleta.
      //
      // ANTI-SPAM que ESTA regla sí garantiza:
      //   · UN chat de consulta por par, estructural: el doc id es
      //     `sortedUids.join('_')`, así que el par no puede tener dos.
      //   · Radio de impacto acotado a PFs publicados que no se cerraron.
      //   El tope de mensajes sin respuesta NO está acá a propósito: todo lo
      //   que las rules podrían mirar (`lastMessageSenderId`, un contador en el
      //   doc padre) lo escribe el mismo cliente que se quiere limitar, y en
      //   un batch las rules leen el estado COMMITEADO, no el pendiente — un
      //   cliente modificado saltea el límite mandando el mensaje sin tocar el
      //   padre. Un tope real necesita estado del servidor (contador desde una
      //   CF `onDocumentCreated`); meter acá uno esquivable sería un gate
      //   decorativo, que es exactamente lo que este bloque prohíbe.
      //
      // MARCA INMUTABLE: `kind` queda pineado en el `update` de abajo, igual
      // que `linkId`. Sin eso, (a) un chat social se convertiría en consulta
      // con un update de una línea, saltándose el gate de follow, y (b) una
      // consulta podría escalar a chat de Coach agregándose un `linkId`.
      //
      // PRESUPUESTO DE LLAMADAS: la rama nueva cuesta 3 (1 exists + 2 get) y
      // sólo se evalúa ella, así que el peor caso de `chats/create` sigue
      // siendo la rama Coach con 4, sobre el techo de 10. Sin cambios.
      function chatCreateOk(members, data) {
        let me = request.auth.uid;
        let other = members[0] == me ? members[1] : members[0];
        return ('linkId' in data) ? (
          exists(/databases/$(database)/documents/trainer_links/$(data.linkId))
          // QA H8: 'paused' cuenta como vínculo vigente para chatear (pausar es
          // un hold temporal, no un corte). Espeja el filtro cliente en
          // ChatRepository._activeLinkIdBetween.
          && get(/databases/$(database)/documents/trainer_links/$(data.linkId)).data.status in ['active', 'paused']
          && get(/databases/$(database)/documents/trainer_links/$(data.linkId)).data.trainerId in members
          && get(/databases/$(database)/documents/trainer_links/$(data.linkId)).data.athleteId in members
        ) : (data.get('kind', '') == 'inquiry') ? (
          exists(/databases/$(database)/documents/trainerPublicProfiles/$(other))
          && get(/databases/$(database)/documents/users/$(other)).data.role == 'trainer'
          && get(/databases/$(database)/documents/trainerPublicProfiles/$(other)).data.get('acceptsInquiries', true) == true
        ) : followAccepted(other, me);
      }

      // Mismo permiso que `senderMayPost`, pero sobre un chat que YA existe, así
      // que sale de `resource.data` y NO paga el `get()` del chat. Igual que
      // allá, `'linkId' in resource.data` va primero para que el Coach no pague
      // ninguna llamada de acceso — y acá esa clave ya es confiable, porque
      // `chatCreateOk` la valida al crear y el `update` la tiene pineada.
      //
      // Costo: 0 llamadas en un chat de Coach, 2 en uno social, y sólo cuando el
      // update toca algo más que `lastRead`.
      //
      // #637: `kind == 'inquiry'` escapa por la MISMA vía y por el mismo
      // motivo. Acá el `||` es legítimo —a diferencia del `create`— porque los
      // dos primeros términos ya no son payload sin validar: son hechos que
      // `chatCreateOk` verificó al crear el doc y que el `update` de abajo
      // tiene pineados. Es una disyunción de hechos confiables, no una
      // validación. Costo de un chat de consulta: 0 llamadas, igual que Coach.
      function chatWriterOk(uid) {
        let other = resource.data.members[0] == uid
          ? resource.data.members[1]
          : resource.data.members[0];
        return 'linkId' in resource.data
            || resource.data.get('kind', '') == 'inquiry'
            || followAccepted(other, uid);
      }

      // ⚠️  QA-SEC-010 — el disyunto `resource == null` está ACOTADO al par que
      // codifica el doc id. Hace falta para que `getOrCreate()` pregunte "¿ya
      // existe este chat?" sin comerse un permission-denied, pero sin acote era
      // el oráculo más sensible de los cuatro: `chatId` es
      // `sorted([a,b]).join('_')` y los uid son enumerables, así que una sola
      // llamada por par respondía **"¿estas dos personas se escriben?"** — el
      // "no existe" volvía como snapshot vacío y el "existe y no sos miembro"
      // como PERMISSION_DENIED.
      //
      // La premisa correcta ya estaba escrita del lado de Storage: el bloque
      // `chatMedia` de `storage.rules` cerró su `get` con gate de membresía
      // citando textualmente que "uids are enumerable (userPublicProfiles is
      // world-readable)". Esto es esa misma premisa aplicada del lado de
      // Firestore.
      //
      // El segundo disyunto queda INTACTO a propósito: es el que prueba el
      // `list` (`where('members', arrayContains: uid)`), y `resource == null`
      // nunca es probablemente-verdadero en una query, así que el primer
      // disyunto corta antes de tocar `chatId` — que en un `list` no está
      // ligado. Verificado contra el emulador.
      allow read: if request.auth != null
                  && ((resource == null
                       && request.auth.uid in chatId.split('_'))
                      || request.auth.uid in resource.data.members);

      allow create: if request.auth != null
                    && request.resource.data.members.size() == 2
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.members[0] < request.resource.data.members[1]
                    && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
                    && chatCreateOk(
                        request.resource.data.members, request.resource.data);

      // REQ-CHATUNREAD-008: members may update the chat (preview fields on
      // send) but a member may only touch THEIR OWN key inside lastRead — a
      // user cannot forge/clear another member's read state. members and
      // createdAt remain immutable. get('lastRead', {}) is null-safe for
      // legacy docs that predate the field.
      //
      // ⚠ `linkId` PINEADO: es la segunda mitad de la invariante que sostiene a
      // `senderMayPost`. Sin este pin, esta regla —que no tiene allowlist de
      // claves— dejaba que cualquier miembro le agregara `linkId` a un chat
      // social con un update de una línea, y se auto-otorgara escritura
      // permanente que sobrevive al unfollow. El idioma `get(...,null)` hace
      // que "ausente en los dos lados" matchee, así que los chats sociales
      // (que no tienen la clave) no se ven afectados, y además impide BORRAR
      // el linkId de un chat de Coach.
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members
                    && request.resource.data.members == resource.data.members
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.get('linkId', null)
                       == resource.data.get('linkId', null)
                    // ⚠ `kind` PINEADO — segunda mitad de la invariante de la
                    // rama de consulta (#637), por el mismo motivo que
                    // `linkId`. Sin el pin, esta regla (que no tiene allowlist
                    // de claves) dejaría convertir un chat social en consulta
                    // con un update de una línea, saltándose el gate de follow
                    // y auto-otorgándose escritura permanente que sobrevive al
                    // unfollow. Y en la otra dirección impide BORRAR la marca
                    // para que una consulta se haga pasar por chat social.
                    // La escalada consulta→Coach ya la corta el pin de
                    // `linkId`: a un chat existente no se le puede agregar.
                    && request.resource.data.get('kind', null)
                       == resource.data.get('kind', null)
                    && (
                         !request.resource.data.keys().hasAny(['lastRead'])
                         || request.resource.data.get('lastRead', {})
                              .diff(resource.data.get('lastRead', {}))
                              .affectedKeys()
                              .hasOnly([request.auth.uid])
                       )
                    // REQ-FOLLOW-012 — el PREVIEW sigue al mismo permiso que el
                    // mensaje. Sin esto el gate de `messages/create` se rodea
                    // por el costado: el lado bloqueado no logra escribir el
                    // mensaje, pero sí `lastMessageText`, que es el texto que la
                    // otra persona ve en su lista de chats, con badge de
                    // no-leído. "No te puede escribir" sería falso.
                    //
                    // Es una ALLOWLIST, no una lista de campos de preview
                    // enumerados: cualquier campo que se agregue mañana al doc
                    // queda denegado por defecto en vez de colarse.
                    //
                    // `lastRead` queda AFUERA de la restricción a propósito
                    // (design §3.3.4): el lado sin escritura tiene que poder
                    // marcar como leído, o el badge de no-leídos se le clava
                    // para siempre. Ese caso no paga ninguna llamada de acceso.
                    && (
                         request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['lastRead'])
                         || chatWriterOk(request.auth.uid)
                       );

      allow delete: if false;

      // Messages sub-collection. Mensajes inmutables en MVP — sin edit/delete.
      // read/create gated por members del chat parent.
      match /messages/{messageId} {
        // REQ-FOLLOW-012 — GATE NUEVO. Hoy esta subcolección gateaba SÓLO por
        // membresía, o sea que el permiso se evaluaba una única vez, al crear el
        // chat: eliminar la relación NO cortaba un chat que ya existía. La
        // asimetría que pide la decisión del dueño es DENTRO del mismo chat
        // (uno escribe, el otro no), y una regla que corre una sola vez no puede
        // producir dos permisos distintos para el mismo documento. Por eso el
        // gate se evalúa por mensaje.
        //
        // ABSORBE el check de membresía en vez de sumarse a él: reusa el mismo
        // `get(chats/{chatId})` que la regla vieja ya hacía para sacar
        // `members`. Por eso el costo no se duplica.
        //
        // Orden de las ramas DELIBERADO: `'linkId' in chat` va PRIMERO para que
        // un chat de Coach no pague ninguna llamada de acceso extra (1, igual
        // que hoy) y quede exactamente como está —membresía, sin re-verificar
        // que el link siga activo—, porque apretar el Coach no es parte de este
        // change. Un chat social paga 3 sobre el techo de 10.
        //
        // #637: la marca de consulta escapa igual que `linkId` y por el mismo
        // motivo — `chatCreateOk` ya verificó al crear que el destinatario es
        // un PF publicado, y el pin del `update` no deja plantarla después. Un
        // chat de consulta paga 1 llamada, igual que uno de Coach. Los DOS
        // miembros pueden postear: el atleta pregunta y el PF contesta, que es
        // el punto entero de la feature.
        function senderMayPost(uid) {
          let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
          let other = chat.members[0] == uid ? chat.members[1] : chat.members[0];
          return uid in chat.members
              && (
                   'linkId' in chat
                   || chat.get('kind', '') == 'inquiry'
                   || followAccepted(other, uid)
                 );
        }

        // Lectura: membresía, SIN CAMBIOS. El lado que perdió la escritura
        // conserva la conversación entera — bloquear también la lectura sería
        // borrarle historia que ya recibió.
        allow read: if request.auth != null
                    && request.auth.uid in
                        get(/databases/$(database)/documents/chats/$(chatId)).data.members;

        // REQ-CHATMEDIA-006: validity is OR-based — text OR (mediaUrl + mediaType).
        // A message is valid if it carries non-empty text OR a mediaUrl string
        // together with a mediaType string (e.g. 'image' / 'video').
        // senderId y createdAt sin cambios; la membresía ahora vive adentro de
        // senderMayPost.
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.senderId
                      && senderMayPost(request.auth.uid)
                      && (
                           (request.resource.data.text is string
                            && request.resource.data.text.size() > 0)
                           ||
                           (request.resource.data.mediaUrl is string
                            && request.resource.data.mediaUrl.size() > 0
                            && request.resource.data.mediaType is string)
                         )
                      && request.resource.data.createdAt is timestamp;

        allow update, delete: if false;
      }
    }

    // Privacy grant: athlete opts in to share their training history with ONE
    // trainer. Doc id == athleteId. The sessions rule reads this via get().
    match /session_shares/{athleteId} {
      allow read: if request.auth != null
                  && (request.auth.uid == athleteId
                      || (resource != null
                          && request.auth.uid == resource.data.trainerId));
      // Only the athlete (owner) may create/update/delete their own grant.
      allow write: if request.auth != null
                   && request.auth.uid == athleteId
                   && (request.resource == null
                       || request.resource.data.trainerId is string);
    }

    // Profile share: athlete opts in to share their personal data (phone,
    // bornAt, heightCm, bodyWeightKg, gender, experienceLevel) with ONE
    // trainer. Doc id == athleteId. Mirrors the session_shares pattern.
    //
    // Slice 1 (web-only groundwork): trainer reads the doc from the Resumen
    // tab. The doc is empty/absent until the athlete opts in via the mobile
    // consent UI (Slice 2 — NOT in this change).
    match /profile_shares/{athleteId} {
      // Athlete reads their own doc; trainer reads when they are the grantee.
      allow read: if request.auth != null
                  && (request.auth.uid == athleteId
                      || (resource != null
                          && request.auth.uid == resource.data.trainerId));
      // Only the athlete may write their own grant doc; trainerId must be a
      // string when the doc is being created or updated (not deleted).
      allow write: if request.auth != null
                   && request.auth.uid == athleteId
                   && (request.resource == null
                       || request.resource.data.trainerId is string);
    }

    // Sessions sub-collection (Fase 4 Etapa 1, REQ-SMS-014).
    // Owner R/W. Trainer granted via session_shares gets read-only access.
    match /users/{uid}/sessions/{sessionId} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid
                      || (exists(/databases/$(database)/documents/session_shares/$(uid))
                          && get(/databases/$(database)/documents/session_shares/$(uid)).data.trainerId == request.auth.uid));
      allow write: if request.auth != null && request.auth.uid == uid;

      // setLogs sub-collection (REQ-SETLOGS-001..004, trainer-athlete-set-logs).
      // Read mirrors parent session-share predicate: owner OR linked trainer.
      // Write is owner-only — trainers (even linked) may never mutate set data.
      // Emulator scenarios: E1 linked reads → allowed; E2 linked lists → allowed;
      // E3 unrelated trainer → denied; E4 no share doc → denied;
      // E5 linked trainer writes → denied; E6 owner reads → allowed;
      // E7 owner writes → allowed; E8 unauthenticated → denied.
      match /setLogs/{setLogId} {
        allow read: if request.auth != null
                    && (request.auth.uid == uid
                        || (exists(/databases/$(database)/documents/session_shares/$(uid))
                            && get(/databases/$(database)/documents/session_shares/$(uid)).data.trainerId == request.auth.uid));
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // exerciseFeedback sub-collection (#628) — el canal que faltaba:
      // alumno → PF, EN PALABRAS y anclado a (exerciseId, setNumber). Es la
      // contraparte simétrica de coach_note.dart (PF → alumno). "chat =
      // palabras sueltas, setLogs = números, exerciseFeedback = palabras
      // ancladas al ejercicio".
      //
      // Read es el MISMO predicado de dos partes que setLogs — dueño OR PF con
      // grant vivo en session_shares — y el dueño va PRIMERO para que `||`
      // corte antes del get(): el alumno leyendo lo suyo nunca depende de un
      // documento que escribe el pipeline de entitlements. Eso lo pinea
      // rules-read-isolation.test.ts §7, que ahora nombra CUATRO cláusulas.
      // Write es owner-only: el PF jamás muta datos del alumno, y este canal
      // es one-way por diseño (#628, "No entra: hilo de conversación").
      //
      // ⚠️ DATO DE SALUD, y por eso el read NO puede ser `request.auth != null`.
      // `kind: 'discomfort'` es dolor/lesión declarada, y `photoUrl` apunta a
      // `sessionFeedback/{uid}/{sessionId}/{file}` en Storage. Esa URL de
      // getDownloadURL() lleva `?alt=media&token=` y es una CREDENCIAL AL
      // PORTADOR: NO evalúa storage.rules (docs/security.md §3.1, medido
      // contra el emulador — 200 sin ningún header de auth). O sea que el
      // gate REAL de la foto es este documento, no el bloque de Storage. Dos
      // consecuencias que mandan sobre cualquier cambio futuro acá:
      //   1. el photoUrl NO se denormaliza a ninguna colección más laxa —
      //      ni userPublicProfiles, ni posts, ni el doc de sesión;
      //   2. aflojar este read a `request.auth != null` publicaría la foto de
      //      una lesión a cualquier cuenta autenticada, y ningún test de
      //      Storage se pondría rojo porque la URL ni siquiera pasa por ahí.
      //
      // Validación de forma en create/update (#508 y #447: las reglas sin
      // validación de tipo se cuelan). Deliberadamente SIN `keys().hasOnly()`
      // — es el trap de forward-compat de #635: pinear el juego de claves
      // rompe a los clientes viejos en cuanto el modelo suma un campo.
      // Se valida el tipo de lo que existe y la única regla de negocio que
      // importa: "nada de reportes vacíos" (#628).
      function feedbackShapeOk(d) {
        return d.exerciseId is string
            && d.exerciseId.size() > 0
            && d.exerciseId.size() <= 128
            && d.exerciseName is string
            && d.exerciseName.size() <= 200
            && d.kind in ['comment', 'discomfort']
            && d.createdAt is timestamp
            && optNumInRange(d.get('setNumber', null), 1, 99)
            && optStrMaxLen(d.get('text', null), 2000)
            && optStrMaxLen(d.get('photoUrl', null), 2000)
            && optStrMaxLen(d.get('photoPath', null), 512)
            // Al menos texto O foto, y NO la cadena vacía en ninguno de los
            // dos: `optStrMaxLen` acepta '' feliz, así que sin esto un reporte
            // con `text: ''` pasaba y le vibraba el teléfono al PF por nada.
            && (
                 (d.get('text', null) is string && d.get('text', null).size() > 0)
                 || (d.get('photoUrl', null) is string && d.get('photoUrl', null).size() > 0)
               );
      }

      match /exerciseFeedback/{feedbackId} {
        allow read: if request.auth != null
                    && (request.auth.uid == uid
                        || (exists(/databases/$(database)/documents/session_shares/$(uid))
                            && get(/databases/$(database)/documents/session_shares/$(uid)).data.trainerId == request.auth.uid));

        allow create, update: if request.auth != null
                              && request.auth.uid == uid
                              && feedbackShapeOk(request.resource.data);

        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // GYM-PRESENCE check-in sub-collection (Fase 4 Etapa 6, REQ-WRC-004).
    // Doc id is the local date key 'YYYY-MM-DD'. Reserved for the "are you at
    // the gym today?" flow — see the still-orphaned checkIn* l10n keys
    // ("¿ESTÁS EN EL GYM HOY?", "SÍ, ENTRÉ") and SCENARIO-272/273/274 in
    // scripts/rules_test/rules.test.js, which assert on a
    // {gymId, gymName, checkedInAt} payload. That feature has no client code
    // yet; the path stays reserved for it.
    //
    // ⚠️ The WELLBEING check-in (#643) used to live here and does NOT any
    // more: it moved to users/{uid}/wellbeingCheckIns below. Same uid + same
    // date produced the same document, so the two features would have
    // collided silently the day gym presence ships. Do not re-point anything
    // here.
    match /users/{uid}/checkIns/{date} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    // Wellbeing check-in sub-collection (#643) — how the athlete felt, pain
    // yes/no + zone in the MuscleGroup vocabulary, and an optional free note.
    // Captured after a session and from the daily card on Home.
    //
    // OWNER-ONLY, read and write, with no exceptions. This is the most
    // sensitive data the app stores: self-reported health. Three consequences
    // that must survive future edits to this block:
    //
    //   1. It is NEVER mirrored to userPublicProfiles.
    //   2. session_shares / profile_shares do NOT open it. Those capabilities
    //      grant a trainer the training history (users/{uid}/sessions/**,
    //      setLogs/**) and the profile snapshot; wellbeing is deliberately
    //      outside that grant. #643 puts trainer sharing explicitly out of
    //      scope: if it ever ships it needs its OWN opt-in and its own issue,
    //      not a widened read here.
    //   3. Doc id is '{date}_{millisUTC}', not the date alone. The date alone
    //      made a second workout on the same day overwrite the first one's
    //      record — last-write-wins on health data. The date is also a real
    //      field of the document, which is what the trend range queries.
    //
    // Deliberately NO shape validation: a `hasOnly` here would reproduce the
    // forward-compat trap documented in #635.
    match /users/{uid}/wellbeingCheckIns/{checkInId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    // Trainer custom exercise library — owner writes, any auth user reads.
    // Each trainer's personal exercise catalogue (names they prefer, video
    // URLs they trust). Hard delete allowed because the routine slots that
    // reference these exercises already denormalize name/group at assign time.
    //
    // Read is auth-only (not owner-only) so an athlete who has a routine
    // referencing a trainer's custom exercise can open its detail screen
    // (video / description). Same privacy stance as the public catalogue
    // and trainer-public templates: an authenticated user could query an
    // exercise if they knew the trainer's uid + exercise id, but the
    // exercise id is auto-generated and only surfaces through routines the
    // user already has access to, so the practical exposure is bounded.
    match /users/{uid}/customExercises/{exId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid;
    }

    // Coach Agenda — availability rules (Fase 5 Etapa 6, REQ-027).
    // Trainers own their rules; athletes and trainers can read any rule
    // (needed to compute free slots client-side). Create/update/delete
    // restricted to the owning trainer.
    // SCENARIOs 525-527 tested via emulator (emulator-deferred per Decision #25).
    // QA-SEC-013 (#780) — dos huecos en el mismo bloque:
    //
    // 1. Sin gate de rol. Medido: una cuenta `role: 'athlete'` creaba su
    //    propia regla de agenda. Se agrega el mismo disyunto de Slice C.
    // 2. Sin `keys().hasOnly()` ni cap de tamaño. Combinado con el `read`
    //    amplio de arriba —que está bien y NO se discute acá— cualquier
    //    autenticado publicaba documentos arbitrarios de hasta 1 MB que
    //    **toda la plataforma puede listar**. El comentario decía
    //    "restricted to the owning trainer": dueño sí, pero de un documento
    //    que se acuñaba solo.
    //
    // La forma sale de `availability_rule.g.dart`, que es la fuente de verdad
    // de lo que emite `toJson()`. `id` VIAJA en el body: el repositorio hace
    // `set(rule.toJson())` y el campo no está anotado para excluirse.
    //
    // ⚠️ `dayOfWeek` es 1..7, NO 0..6. Sale de `DateTime.monday` (=1) en
    // `availability_editor_screen.dart` y del mapa
    // `AgendaFormatters.dayOfWeekLabels` (1: Lunes … 7: Domingo). Escribir
    // 0..6 acá habría denegado en silencio todas las reglas de **domingo**.
    // Las horas son `TimeOfDay`, así que 0..23 / 0..59.
    //
    // El cruce start < end NO se valida acá a propósito: es regla de negocio
    // que el editor ya aplica, y duplicarla dejaría dos definiciones que se
    // desincronizan. Acá se acota la FORMA, que es lo que cierra el vector de
    // basura arbitraria.
    match /coach_availability_rules/{ruleId} {
      function ruleShapeOk(d) {
        return d.keys().hasOnly(['id', 'trainerId', 'dayOfWeek', 'startHour',
                                 'startMinute', 'endHour', 'endMinute',
                                 'slotDurationMin'])
               && d.keys().hasAll(['id', 'trainerId', 'dayOfWeek', 'startHour',
                                   'startMinute', 'endHour', 'endMinute',
                                   'slotDurationMin'])
               && d.id is string && d.id.size() <= 128
               && d.dayOfWeek is int && d.dayOfWeek >= 1 && d.dayOfWeek <= 7
               && d.startHour is int && d.startHour >= 0 && d.startHour <= 23
               && d.startMinute is int && d.startMinute >= 0 && d.startMinute <= 59
               && d.endHour is int && d.endHour >= 0 && d.endHour <= 23
               && d.endMinute is int && d.endMinute >= 0 && d.endMinute <= 59
               && (d.slotDurationMin == 30 || d.slotDurationMin == 60
                   || d.slotDurationMin == 90 || d.slotDurationMin == 120);
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.trainerId == request.auth.uid
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'
                    && ruleShapeOk(request.resource.data);
      // El `update` pide rol igual que el `create`. La primera versión de este
      // change no lo hacía —me apoyé en que el alcance del issue sólo pedía el
      // gate de update para `trainerPublicProfiles`— y era **incoherente con mi
      // propio argumento**: si cerrar sólo `create` "deja vivo lo que ya se
      // coló" para el directorio de PFs, vale igual para la agenda. Peor acá,
      // porque esta colección es mundo-legible: un atleta con una regla
      // forjada antes del gate podría seguir reemplazando indefinidamente una
      // agenda que **toda la plataforma lee**. Lo marcó el bot de review.
      allow update: if request.auth != null
                    && resource.data.trainerId == request.auth.uid
                    && request.resource.data.trainerId == request.auth.uid
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'
                    && ruleShapeOk(request.resource.data);
      allow delete: if request.auth != null
                    && resource.data.trainerId == request.auth.uid;
    }

    // Coach Agenda — availability overrides (Fase 5 Etapa 6, REQ-028).
    // Same ownership model as rules.
    // Mismo par de huecos y mismo arreglo que `coach_availability_rules`
    // (QA-SEC-013, #780).
    //
    // ⚠️ Acá la forma NO es una sola: `AvailabilityOverride` es una unión
    // sellada discriminada por `type` (ADR-6), y las dos variantes tienen
    // juegos de claves distintos —`block` lleva 4, `extra` lleva 9—. El
    // `hasOnly()` de arriba lista las 9 y acepta las dos, porque hasOnly es un
    // techo y no un piso; lo que las distingue es el `hasAll()` por variante.
    // Si se escribiera un solo `hasAll` con los 9 campos se denegarían **todos
    // los días bloqueados**, que son la mitad de la feature.
    match /coach_availability_overrides/{overrideId} {
      function overrideShapeOk(d) {
        return d.keys().hasOnly(['id', 'trainerId', 'date', 'type', 'startHour',
                                 'startMinute', 'endHour', 'endMinute',
                                 'slotDurationMin'])
               && d.keys().hasAll(['id', 'trainerId', 'date', 'type'])
               && d.id is string && d.id.size() <= 128
               && d.date is timestamp
               && (
                    (d.type == 'block'
                     && d.keys().hasOnly(['id', 'trainerId', 'date', 'type']))
                    ||
                    (d.type == 'extra'
                     && d.keys().hasAll(['startHour', 'startMinute', 'endHour',
                                         'endMinute', 'slotDurationMin'])
                     && d.startHour is int && d.startHour >= 0 && d.startHour <= 23
                     && d.startMinute is int && d.startMinute >= 0 && d.startMinute <= 59
                     && d.endHour is int && d.endHour >= 0 && d.endHour <= 23
                     && d.endMinute is int && d.endMinute >= 0 && d.endMinute <= 59
                     && (d.slotDurationMin == 30 || d.slotDurationMin == 60
                         || d.slotDurationMin == 90 || d.slotDurationMin == 120))
                  );
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.trainerId == request.auth.uid
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'
                    && overrideShapeOk(request.resource.data);
      // Mismo gate de rol que en `coach_availability_rules`, por el mismo
      // motivo: sin él, un override forjado antes del gate seguiría siendo
      // editable para siempre sobre una colección mundo-legible.
      allow update: if request.auth != null
                    && resource.data.trainerId == request.auth.uid
                    && request.resource.data.trainerId == request.auth.uid
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'
                    && overrideShapeOk(request.resource.data);
      allow delete: if request.auth != null
                    && resource.data.trainerId == request.auth.uid;
    }

    // Coach Agenda — appointments (Fase 5 Etapa 6, REQ-029, ADR-1, ADR-5).
    // Create: athlete books their own slot (status must be 'confirmed').
    // Update: two valid paths —
    //   Path 1 (cancellation): member cancels with >24h notice.
    //   Path 2 (ADR-1 flip): new athlete flips cancelled → confirmed.
    // Delete: never (audit trail preserved per ADR-1).
    match /appointments/{appointmentId} {
      // Forma del turno (QA-SEC-014). Las claves salen de
      // `appointment.g.dart`, que es lo que realmente emite `toJson()` — son
      // las 14 que el cliente manda siempre, nulls incluidos.
      //
      // `hasOnly` es el que cierra el vector de basura arbitraria. El `hasAll`
      // se limita a los 7 campos NO nullables del modelo: pedir los 14
      // rompería cualquier escritura que omita un opcional, y `hasOnly` ya
      // alcanza para el objetivo.
      //
      // `cancellationLog` es una lista de objetos; las reglas no pueden
      // validar su contenido en profundidad, así que se le acota el largo —
      // que es lo que evita el inflado del documento.
      function appointmentShapeOk(d) {
        return d.keys().hasOnly(['id', 'trainerId', 'athleteId',
                                 'athleteDisplayName', 'startsAt',
                                 'durationMin', 'status', 'cancelledAt',
                                 'cancelledBy', 'cancellationLog',
                                 'noteBefore', 'noteAfter', 'recurringId',
                                 'paymentId'])
               && d.keys().hasAll(['id', 'trainerId', 'athleteId',
                                   'athleteDisplayName', 'startsAt',
                                   'durationMin', 'status'])
               && d.athleteDisplayName is string
               && d.athleteDisplayName.size() <= 200
               && optStrMaxLen(d.get('noteBefore', null), 5000)
               && optStrMaxLen(d.get('noteAfter', null), 5000)
               && optStrMaxLen(d.get('cancelledBy', null), 128)
               && optStrMaxLen(d.get('recurringId', null), 128)
               && optStrMaxLen(d.get('paymentId', null), 128)
               && d.durationMin is int
               && d.durationMin > 0 && d.durationMin <= 600
               && d.startsAt is timestamp
               && d.startsAt.toMillis() > request.time.toMillis() - 86400000
               && d.startsAt.toMillis() < request.time.toMillis() + 5184000000
               && d.get('cancellationLog', []).size() <= 50;
      }

      // Variante para `update`. Misma cota de claves y de texto, PERO sin el
      // rango de `startsAt`, y no es un descuido: el Path 3 de abajo es el PF
      // cargando `noteAfter` **después** de la sesión, o sea con `startsAt` ya
      // en el pasado. Reusar `appointmentShapeOk()` acá denegaría todas las
      // notas post-sesión, que es el uso normal de la feature.
      //
      // `startsAt` no necesita rango en el update porque los tres caminos ya
      // lo pinean inmutable contra `resource.data`.
      function appointmentUpdateShapeOk(d) {
        return d.keys().hasOnly(['id', 'trainerId', 'athleteId',
                                 'athleteDisplayName', 'startsAt',
                                 'durationMin', 'status', 'cancelledAt',
                                 'cancelledBy', 'cancellationLog',
                                 'noteBefore', 'noteAfter', 'recurringId',
                                 'paymentId'])
               && optStrMaxLen(d.get('athleteDisplayName', null), 200)
               && optStrMaxLen(d.get('noteBefore', null), 5000)
               && optStrMaxLen(d.get('noteAfter', null), 5000)
               && optStrMaxLen(d.get('cancelledBy', null), 128)
               && optStrMaxLen(d.get('recurringId', null), 128)
               && optStrMaxLen(d.get('paymentId', null), 128)
               && d.get('cancellationLog', []).size() <= 50;
      }

      // Privacy: a member only reads appointments they are part of — their own
      // (athleteId) or the ones they run (trainerId). Closes the prior
      // any-authenticated-user read. Safe now that athlete self-booking (whose
      // transaction `get` read foreign slots) is removed in the read-only model.
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.athleteId
                      || request.auth.uid == resource.data.trainerId);
      // Create: either the athlete books their own slot (legacy self-booking),
      // or the trainer registers a session (new trainer-driven model 2026-06-03).
      //
      // rules-hardening Slice C (AD-1 option b) — Coach-Collection Create
      // Requires Trainer Role: the trainer-create disjunct additionally
      // requires `users/{uid}.role == 'trainer'` so an athlete-role user
      // cannot forge an appointment naming themselves as trainerId against
      // an arbitrary victim athlete. The gate applies ONLY to the trainer
      // disjunct — the legacy athlete self-book disjunct (`athleteId ==
      // auth.uid`) is UNCHANGED, preserving that live path (regression-
      // tested: SCENARIO-CC-08). Role-check only, NOT a trainer_links
      // relationship check — see design.md AD-1 / engram obs #413.
      //
      // QA-SEC-014 (#781) — el create no validaba NADA del documento: sin
      // `keys().hasOnly()`, sin cap en ningún campo de texto, sin rango en
      // `startsAt`. Medido: un desconocido escribía un turno `confirmed` en la
      // agenda de CUALQUIER PF con 30 KB de texto arbitrario en
      // `athleteDisplayName` y `noteBefore`. Y no se podía sacar:
      // `allow delete: if false`, y la cancelación exige >24 h de
      // anticipación, así que un turno forjado con `startsAt` cercano o pasado
      // quedaba **fijo** en la agenda hasta que alguien entrara con Admin SDK.
      //
      // Es la única colección escribible por un tercero del archivo que no
      // acotaba su texto libre (`athlete_notes` <5000, `follow_up_entries`
      // <5000, `nutrition_plans` <200, `payments` <=200, `measurements`
      // <=2000). Era un olvido, no una decisión.
      //
      // El auto-booking NO se toca (Slice C lo dejó explícitamente intacto) ni
      // se exige `trainer_links`: eso es cambio de producto. Acá sólo se acota
      // QUÉ se puede meter adentro del documento.
      //
      // ⚠️ `startsAt` es **wall-clock UTC**, no un instante real (ADR-7,
      // QA-COA-003): en ART (UTC−3) el valor guardado queda 3 h ANTES del
      // instante real. Un `startsAt > request.time` a secas denegaría toda
      // reserva dentro de las próximas 3 horas. Por eso el rango lleva un día
      // de tolerancia hacia atrás — absorbe cualquier offset de zona horaria
      // (±14 h) sin dejar de matar el vector, que es el turno forjado en 1970
      // o en el año 3000. El tope a futuro es 60 días: el cliente ya acota a
      // 28 (`REQ-COACH-AGENDA-009`), así que sobra margen y la regla nunca
      // deniega algo que el cliente produjo.
      //
      // Lo que este cambio NO arregla, y conviene tener escrito: un turno
      // legítimo creado a menos de 24 h tampoco se puede cancelar, porque el
      // Path 1 de abajo exige >24 h. Eso es un hueco de PRODUCTO preexistente
      // —el cliente permite reservar más cerca que eso— y apretarlo acá
      // rompería reservas válidas. Ver §4.9.
      allow create: if request.auth != null
                    && request.resource.data.status == 'confirmed'
                    && appointmentShapeOk(request.resource.data)
                    && (request.resource.data.athleteId == request.auth.uid
                        || (request.resource.data.trainerId == request.auth.uid
                            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'));
      // Update has 3 valid paths: cancellation by member, flip cancelled→confirmed,
      // or trainer edits coaching notes.
      //
      // QA-SEC-014 (#781): la cota de forma se aplica a los TRES caminos, con
      // un `&&` afuera del paréntesis. Ninguno la tenía, así que el cap del
      // `create` se esquivaba creando un turno chico y engordándolo después.
      allow update: if request.auth != null
                    && appointmentUpdateShapeOk(request.resource.data)
                    && (
        // Path 1: cancellation by member with >24h
        (request.resource.data.status == 'cancelled'
         && (request.auth.uid == resource.data.athleteId
             || request.auth.uid == resource.data.trainerId)
         && resource.data.startsAt.toMillis() - 86400000 > request.time.toMillis())
        ||
        // Path 2: flip cancelled→confirmed by new athlete (ADR-1)
        (resource.data.status == 'cancelled'
         && request.resource.data.status == 'confirmed'
         && request.resource.data.athleteId == request.auth.uid)
        ||
        // Path 3: trainer edits coaching notes OR links a Payment on their own
        // appointment (Slice 2a, Agenda→cobro bridge, money-critical).
        // status / athleteId / trainerId / startsAt stay immutable.
        // `paymentId` is SET-ONCE: null → a NON-EMPTY STRING (first bill), or
        // re-assert the SAME value (a notes edit that leaves the charge alone).
        // A client can never overwrite it with a different Payment id, clear it
        // back to null, nor forge an empty / non-string value.
        // NOTE: we deliberately do NOT exists()-check the Payment here —
        // billAppointment creates the Payment and sets paymentId in the SAME
        // Firestore transaction, and rules exists() reads pre-commit state, so
        // an exists() check would reject the legitimate atomic flow.
        (request.auth.uid == resource.data.trainerId
         && request.resource.data.status == resource.data.status
         && request.resource.data.athleteId == resource.data.athleteId
         && request.resource.data.trainerId == resource.data.trainerId
         && request.resource.data.startsAt == resource.data.startsAt
         && ((resource.data.get('paymentId', null) == null
              && request.resource.data.get('paymentId', null) is string
              && request.resource.data.get('paymentId', null).size() > 0)
             || request.resource.data.get('paymentId', null) == resource.data.get('paymentId', null)))
      );
      allow delete: if false;
    }

    // commercialPlans block REMOVED 2026-05-28. The dual pricing model was
    // confusing trainers; pricing now lives ONLY on the trainer's public
    // profile via trainerMonthlyRate. A future subscribe flow may
    // reintroduce a plan catalog with its own rules block.

    // Body measurements / anthropometry. Written by the TRAINER who recorded
    // them (recordedBy) OR self-logged by the athlete about themselves
    // (athlete-self-measurements). The athlete always reads their own; a
    // linked+consented trainer reads the athlete's self-logged ones.
    match /measurements/{measurementId} {
      // QA #508 — value type/range validation, following the payments /
      // athlete_billing idiom (QA-PAY-007). Before this, `measurements` only
      // validated athleteId/recordedBy: no value field was checked at all, so a
      // modified client could persist a negative weight, a string where a
      // number belongs, or an unbounded `notes` blob.
      //
      // Shared by create AND update: MeasurementRepository.add and .update both
      // write the FULL model via `set(m.toJson())` (no merge), so
      // request.resource.data is the complete document on both paths and a
      // single guard covers both — no need for the diff()/affectedKeys() split
      // athlete_billing requires for its merge writes.
      //
      // Bounds MIRROR the client validator (`parsed < 0 || parsed >
      // _kMaxMetricValue`, _kMaxMetricValue = 500 in log_measurement_screen.dart)
      // instead of inventing physiological per-field ranges. The hole being
      // closed is a modified client SKIPPING that form validator, so the rule
      // enforces exactly what the legit form already enforces — a tighter bound
      // would reject values the real UI happily accepts. Every numeric field
      // shares one validator there, hence one uniform [0, 500] here.
      //
      // Optional fields are read via get(field, null): json_serializable emits
      // every optional key with an explicit null, and an all-null-but-one doc
      // is the normal shape (the form saves whatever subset was filled in).
      //
      // `id` is type-checked but deliberately NOT pinned to the doc id (unlike
      // payments). MeasurementRepository._fromDoc rebuilds the model with
      // `{...data, 'id': snap.id}`, so the body copy is never read — pinning it
      // would add a field-PRESENCE requirement that protects nothing observable
      // while rejecting the legitimately id-less docs that
      // scripts/rules_test/measurements-self-log.test.js writes.
      //
      // ⚠️  COUPLING WARNING — the hasOnly list below is the exact key set of
      // Measurement.toJson() (measurement.g.dart). Adding a field to the Dart
      // model without adding it here makes EVERY write to this collection fail.
      function measurementShapeOk(d) {
        return d.keys().hasOnly([
                 'id', 'athleteId', 'recordedBy', 'recordedAt',
                 'weightKg', 'fatPercentage', 'muscleMassKg',
                 'shouldersCm', 'chestCm', 'waistCm', 'hipsCm', 'glutesCm',
                 'bicepsLCm', 'bicepsRCm', 'bicepsFlexedLCm', 'bicepsFlexedRCm',
                 'forearmLCm', 'forearmRCm',
                 'upperThighLCm', 'upperThighRCm', 'midThighLCm', 'midThighRCm',
                 'calfLCm', 'calfRCm',
                 'notes'
               ])
               && optStrMaxLen(d.get('id', null), 128)
               && d.get('recordedAt', null) is timestamp
               && optNumInRange(d.get('weightKg', null), 0, 500)
               && optNumInRange(d.get('fatPercentage', null), 0, 500)
               && optNumInRange(d.get('muscleMassKg', null), 0, 500)
               && optNumInRange(d.get('shouldersCm', null), 0, 500)
               && optNumInRange(d.get('chestCm', null), 0, 500)
               && optNumInRange(d.get('waistCm', null), 0, 500)
               && optNumInRange(d.get('hipsCm', null), 0, 500)
               && optNumInRange(d.get('glutesCm', null), 0, 500)
               && optNumInRange(d.get('bicepsLCm', null), 0, 500)
               && optNumInRange(d.get('bicepsRCm', null), 0, 500)
               && optNumInRange(d.get('bicepsFlexedLCm', null), 0, 500)
               && optNumInRange(d.get('bicepsFlexedRCm', null), 0, 500)
               && optNumInRange(d.get('forearmLCm', null), 0, 500)
               && optNumInRange(d.get('forearmRCm', null), 0, 500)
               && optNumInRange(d.get('upperThighLCm', null), 0, 500)
               && optNumInRange(d.get('upperThighRCm', null), 0, 500)
               && optNumInRange(d.get('midThighLCm', null), 0, 500)
               && optNumInRange(d.get('midThighRCm', null), 0, 500)
               && optNumInRange(d.get('calfLCm', null), 0, 500)
               && optNumInRange(d.get('calfRCm', null), 0, 500)
               && optStrMaxLen(d.get('notes', null), 2000);
      }

      // READ branches, cheapest first so get()s only run for the trainer path:
      //   1. author (trainer OR self-logging athlete) — pure field compare.
      //   2. subject athlete — own vantage — pure field compare.
      //   3. [athlete-self-measurements] a SELF-LOGGED doc
      //      (recordedBy == athleteId) is readable by a trainer ONLY when BOTH
      //      fixed-path share docs name them: session_shares (live link, kept
      //      by the syncSessionShareOnTrainerLink CF → follows the CURRENT
      //      trainer) AND profile_shares (the athlete's own consent toggle,
      //      the same surface that shares weight/height). Both are keyed by
      //      athleteId, so a trainer's athleteId-scoped list resolves them ONCE
      //      (cached), not per-doc — the same idiom already live for setLogs
      //      (~:852). This is NOT gated on the dead `sharedWithTrainer` bool
      //      (design.md ADR-ASM-2). Ordering is load-bearing: branches 1/2
      //      short-circuit before any get().
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.recordedBy
                      || request.auth.uid == resource.data.athleteId
                      || (resource.data.recordedBy == resource.data.athleteId
                          && exists(/databases/$(database)/documents/session_shares/$(resource.data.athleteId))
                          && get(/databases/$(database)/documents/session_shares/$(resource.data.athleteId)).data.trainerId == request.auth.uid
                          && exists(/databases/$(database)/documents/profile_shares/$(resource.data.athleteId))
                          && get(/databases/$(database)/documents/profile_shares/$(resource.data.athleteId)).data.trainerId == request.auth.uid));
      // CREATE — dual OR-branch (mirrors the appointments athlete-self-book /
      // trainer+role pattern). `recordedBy == uid` + athleteId shape checks are
      // a SHARED precondition of both branches, so a self-logged doc is always
      // recordedBy == athleteId == uid. The `||` short-circuits on the
      // athlete-self branch, so a self-logging athlete never triggers the role
      // get(); a forger naming ANOTHER athleteId always falls through to the
      // role check and is denied (AD-1 forge vector stays closed).
      allow create: if request.auth != null
                    && request.resource.data.recordedBy == request.auth.uid
                    && request.resource.data.athleteId is string
                    && request.resource.data.athleteId.size() > 0
                    // QA #508 — value shape. Placed BEFORE the branch below so
                    // a malformed doc is rejected without paying for the role
                    // get() on the trainer path.
                    && measurementShapeOk(request.resource.data)
                    && (
                         // Athlete-self branch: may log ONLY about themselves.
                         request.resource.data.athleteId == request.auth.uid
                         // Trainer branch (unchanged from rules-hardening Slice C).
                         || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'
                       );
      allow update: if request.auth != null
                    && resource.data.recordedBy == request.auth.uid
                    && request.resource.data.recordedBy == resource.data.recordedBy
                    && request.resource.data.athleteId == resource.data.athleteId
                    && measurementShapeOk(request.resource.data);
      allow delete: if request.auth != null
                    && resource.data.recordedBy == request.auth.uid;
    }

    // Performance tests / physical assessments. Owned by the TRAINER who recorded
    // them (recordedBy). The athlete gets read-only of their own. No one else.
    match /performance_tests/{testId} {
      // QA #508 — value type/range validation. Same rationale as the
      // measurements guard above (both collections were left unvalidated by
      // rules-hardening Slice C, which only added the role gate), and likewise
      // shared by create and update: PerformanceTestRepository.add and .update
      // both `set(t.toJson())` the full model, no merge.
      //
      // Bounds mirror this screen's OWN validator, which differs from the
      // measurements one: log_performance_test_screen.dart rejects
      // `parsed <= 0` and sets NO ceiling. So the floor here is strictly
      // positive — note that includes sitAndReachCm, which is conventionally a
      // SIGNED metric but which the form already refuses to take negative; the
      // rule deliberately tracks the app's contract, not the textbook one.
      // The 100000 ceiling is the part the client lacks: it exists purely to
      // block absurd magnitudes (same spirit as payments' amountArs cap) and
      // sits ~25x above the largest plausible value in the set (cooperMeters,
      // ~4000 m for a world-class 12-minute test), so it cannot reject real data.
      //
      // `id` is type-checked but NOT pinned to the doc id — same reasoning as
      // the measurements guard above (PerformanceTestRepository._fromDoc also
      // rebuilds the model with the snapshot id, so the body copy is inert).
      //
      // ⚠️  COUPLING WARNING — the hasOnly list below is the exact key set of
      // PerformanceTest.toJson() (performance_test.g.dart). Adding a field to
      // the Dart model without adding it here makes EVERY write fail.
      function performanceTestShapeOk(d) {
        return d.keys().hasOnly([
                 'id', 'athleteId', 'recordedBy', 'recordedAt',
                 'cmjCm', 'squatJumpCm', 'abalakovCm', 'broadJumpCm',
                 'sprint10mS', 'sprint20mS', 'sprint30mS', 'sprint40mS',
                 'squat1rmKg', 'benchPress1rmKg', 'deadlift1rmKg',
                 'overheadPress1rmKg', 'pullUp1rmKg',
                 'vo2maxMlKgMin', 'courseNavetteLevel', 'cooperMeters',
                 'sitAndReachCm',
                 'notes'
               ])
               && optStrMaxLen(d.get('id', null), 128)
               && d.get('recordedAt', null) is timestamp
               && optPositiveNum(d.get('cmjCm', null), 100000)
               && optPositiveNum(d.get('squatJumpCm', null), 100000)
               && optPositiveNum(d.get('abalakovCm', null), 100000)
               && optPositiveNum(d.get('broadJumpCm', null), 100000)
               && optPositiveNum(d.get('sprint10mS', null), 100000)
               && optPositiveNum(d.get('sprint20mS', null), 100000)
               && optPositiveNum(d.get('sprint30mS', null), 100000)
               && optPositiveNum(d.get('sprint40mS', null), 100000)
               && optPositiveNum(d.get('squat1rmKg', null), 100000)
               && optPositiveNum(d.get('benchPress1rmKg', null), 100000)
               && optPositiveNum(d.get('deadlift1rmKg', null), 100000)
               && optPositiveNum(d.get('overheadPress1rmKg', null), 100000)
               && optPositiveNum(d.get('pullUp1rmKg', null), 100000)
               && optPositiveNum(d.get('vo2maxMlKgMin', null), 100000)
               && optPositiveNum(d.get('courseNavetteLevel', null), 100000)
               && optPositiveNum(d.get('cooperMeters', null), 100000)
               && optPositiveNum(d.get('sitAndReachCm', null), 100000)
               && optStrMaxLen(d.get('notes', null), 2000);
      }

      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.recordedBy
                      || request.auth.uid == resource.data.athleteId);
      // rules-hardening Slice C (AD-1 option b) — Coach-Collection Create
      // Requires Trainer Role: closes the "any athlete-role user forges a
      // performance_test naming themselves recordedBy" vector. Role-check
      // only, NOT a trainer_links relationship check — see design.md AD-1 /
      // engram obs #413.
      allow create: if request.auth != null
                    && request.resource.data.recordedBy == request.auth.uid
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'
                    && request.resource.data.athleteId is string
                    && request.resource.data.athleteId.size() > 0
                    && performanceTestShapeOk(request.resource.data);
      allow update: if request.auth != null
                    && resource.data.recordedBy == request.auth.uid
                    && request.resource.data.recordedBy == resource.data.recordedBy
                    && request.resource.data.athleteId == resource.data.athleteId
                    && performanceTestShapeOk(request.resource.data);
      allow delete: if request.auth != null
                    && resource.data.recordedBy == request.auth.uid;
    }

    // Per-athlete billing config set by the trainer (Pagos P1).
    // Doc id is deterministic: `${trainerId}_${athleteId}`.
    match /athlete_billing/{docId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.trainerId
                      || request.auth.uid == resource.data.athleteId);
      // rules-hardening Slice C (AD-1 option b) — Coach-Collection Create
      // Requires Trainer Role: closes the "any athlete-role user forges
      // athlete_billing naming themselves trainer" vector. This is a
      // COMBINED create+update rule block, so the role gate is scoped to
      // create-only via `resource == null` (create has no prior resource
      // doc) — legit trainer UPDATES to their existing billing config are
      // unaffected (SCENARIO-CC-06e regression test). Role-check only, NOT
      // a trainer_links relationship check — see design.md AD-1 / engram
      // obs #413.
      // QA-PAY-007 (#447): the combined create+update block is split so each
      // side can validate the money fields at the right strictness.
      //
      // CREATE — strict shape: the model is exactly {trainerId, athleteId,
      // amountArs, cadence, updatedAt} (AthleteBilling.toJson) and the doc id
      // is deterministic `${trainerId}_${athleteId}`, so both are enforced.
      allow create: if request.auth != null
                  && request.resource.data.trainerId == request.auth.uid
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'
                  && request.resource.data.athleteId is string
                  && request.resource.data.athleteId.size() > 0
                  && docId == request.resource.data.trainerId + '_' + request.resource.data.athleteId
                  && request.resource.data.keys().hasOnly([
                       'trainerId', 'athleteId', 'amountArs', 'cadence', 'updatedAt'
                     ])
                  && request.resource.data.amountArs is int
                  && request.resource.data.amountArs > 0
                  && request.resource.data.amountArs <= 100000000
                  && request.resource.data.cadence in ['mensual', 'semanal', 'por_sesion', 'suelto']
                  && request.resource.data.updatedAt is timestamp;
      // UPDATE — diff-based instead of keys().hasOnly(): setConfig writes via
      // set(merge:true), so request.resource.data is the POST-merge doc. A
      // legacy doc carrying a zombie field (e.g. pre-model monthlyRate) would
      // never pass a strict hasOnly again even though the client didn't touch
      // that field. affectedKeys() gates what the write CHANGES (identity
      // fields trainerId/athleteId immutable by omission) while the final
      // money values are still validated.
      allow update: if request.auth != null
                  && resource.data.trainerId == request.auth.uid
                  && request.resource.data.trainerId == request.auth.uid
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                       'amountArs', 'cadence', 'updatedAt'
                     ])
                  && request.resource.data.amountArs is int
                  && request.resource.data.amountArs > 0
                  && request.resource.data.amountArs <= 100000000
                  && request.resource.data.cadence in ['mensual', 'semanal', 'por_sesion', 'suelto']
                  && request.resource.data.updatedAt is timestamp;
      allow delete: if request.auth != null && resource.data.trainerId == request.auth.uid;
    }

    // Private per-athlete coaching note written by the trainer. Trainer-only —
    // the athlete cannot read it.
    match /athlete_notes/{docId} {
      // Read: dueño solo (trainer). Si el doc NO existe, `resource == null` y
      // la rule debe permitir la lectura para que el cliente vea "sin nota"
      // en vez de un permission-denied que la UI captura como error.
      //
      // ⚠️  QA-SEC-010 — ese disyunto está ACOTADO al PF que el docId encodea.
      // El comentario anterior decía que un atacante "no puede fishearse
      // leyendo docs de otro PF: solo llegaría al doc si armara el par exacto
      // — y si existe, el segundo check bloquea el acceso". Las dos mitades
      // medían falso: armar el par exacto es trivial (los padrones de uid de
      // `userPublicProfiles` y `trainerPublicProfiles` son list-ables por
      // cualquier autenticado), y el segundo check bloquea el CONTENIDO, no la
      // PREGUNTA — "no existe" volvía como snapshot vacío y "existe y es de
      // otro PF" como PERMISSION_DENIED. Cruzando los dos padrones eso
      // reconstruye la cartera de clientes de cada PF sin leer un solo campo.
      //
      // Con `docId.split('_')[0] == request.auth.uid` sólo el PF dueño del
      // prefijo puede preguntar, y para todos los demás los dos estados se ven
      // igual. Mismo idiom que `storage.rules:athleteFiles`, con la misma
      // condición de validez: uid de Firebase Auth sin guión bajo
      // (docs/security.md §1.7).
      allow read: if request.auth != null
                  && ((resource == null
                       && docId.split('_')[0] == request.auth.uid)
                      || request.auth.uid == resource.data.trainerId);
      // Create y update SEPARADOS (QA-2026-07-30 C1). Antes iban combinados
      // validando SOLO el post-image, con dos agujeros que el docId
      // determinístico `{trainerId}_{athleteId}` (enumerable) hacía triviales:
      //   1) Squat: un atacante creaba el doc en el docId de OTRO PF con su
      //      propio trainerId, dejando a la víctima sin poder escribir su nota
      //      (su update fallaba porque resource.data.trainerId != su uid).
      //   2) Hijack: como update no fijaba el trainerId previo, un tercero
      //      reasignaba trainerId con set(merge:true) preservando `note`, y
      //      después leía la nota privada (la read gate mira resource.data.
      //      trainerId, el mismo campo que el update dejaba reescribir).
      // Fix (mismo patrón que follow_up_entries / nutrition_plans): en create
      // ligar el docId al uid firmante; en update fijar la identidad al
      // pre-image para que trainerId/athleteId sean inmutables.
      allow create: if request.auth != null
                  && request.resource.data.trainerId == request.auth.uid
                  && request.resource.data.athleteId is string
                  && request.resource.data.athleteId.size() > 0
                  && docId == request.resource.data.trainerId + '_'
                              + request.resource.data.athleteId
                  && request.resource.data.note is string
                  && request.resource.data.note.size() < 5000;
      allow update: if request.auth != null
                  && resource.data.trainerId == request.auth.uid
                  && request.resource.data.trainerId == resource.data.trainerId
                  && request.resource.data.athleteId == resource.data.athleteId
                  && request.resource.data.note is string
                  && request.resource.data.note.size() < 5000;
      allow delete: if request.auth != null && resource.data.trainerId == request.auth.uid;
    }

    // Archivos privados que el PF sube sobre un alumno (PDFs, imágenes).
    // Mismo pattern que /athlete_notes: doc id es `{trainerId}_{athleteId}_{ts}`,
    // trainer-only R/W, alumno NUNCA los ve. Query paginable por
    // (trainerId, athleteId, uploadedAt desc). List gate garantiza que solo
    // el PF vinculado lista los archivos del alumno.
    match /athlete_files/{docId} {
      allow read, list: if request.auth != null
                  && request.auth.uid == resource.data.trainerId;
      allow create: if request.auth != null
                  && request.resource.data.trainerId == request.auth.uid
                  && request.resource.data.athleteId is string
                  && request.resource.data.athleteId.size() > 0
                  && request.resource.data.fileName is string
                  && request.resource.data.fileName.size() > 0
                  && request.resource.data.storagePath is string
                  && request.resource.data.downloadUrl is string
                  && request.resource.data.sizeBytes is int
                  && request.resource.data.sizeBytes > 0
                  && request.resource.data.sizeBytes <= 10 * 1024 * 1024;
      // Update no habilitado — para reemplazar contenido se borra y sube
      // de nuevo. Evita drift entre downloadUrl y storagePath.
      allow update: if false;
      allow delete: if request.auth != null
                  && request.auth.uid == resource.data.trainerId;
    }

    // Follow-up entries — log cronológico privado del PF sobre un alumno.
    // Mismo patrón que athlete_files: docId `{trainerId}_{athleteId}_{ts}`,
    // trainer-only R/W, alumno NUNCA lo ve. Update permite cambiar texto y
    // tag pero NO los identificadores (trainerId, athleteId, recordedAt).
    match /follow_up_entries/{docId} {
      allow read, list: if request.auth != null
                  && request.auth.uid == resource.data.trainerId;
      allow create: if request.auth != null
                  && request.resource.data.trainerId == request.auth.uid
                  && request.resource.data.athleteId is string
                  && request.resource.data.athleteId.size() > 0
                  && request.resource.data.text is string
                  && request.resource.data.text.size() > 0
                  && request.resource.data.text.size() < 5000
                  && request.resource.data.tag is string;
      allow update: if request.auth != null
                  && resource.data.trainerId == request.auth.uid
                  && request.resource.data.trainerId == resource.data.trainerId
                  && request.resource.data.athleteId == resource.data.athleteId
                  && request.resource.data.recordedAt == resource.data.recordedAt
                  && request.resource.data.text is string
                  && request.resource.data.text.size() > 0
                  && request.resource.data.text.size() < 5000
                  && request.resource.data.tag is string;
      allow delete: if request.auth != null
                  && request.auth.uid == resource.data.trainerId;
    }

    // Nutrition plan — un plan por par PF↔alumno, docId `{trainerId}_{athleteId}`.
    // Trainer-only R/W. El alumno NO lo ve en mobile todavía (feature scoped
    // aparte). Update preserva trainerId y athleteId. `meals` es un list —
    // no validamos la estructura en rules (validación se hace client-side).
    match /nutrition_plans/{docId} {
      allow read, list: if request.auth != null
                  && request.auth.uid == resource.data.trainerId;
      allow create: if request.auth != null
                  && request.resource.data.trainerId == request.auth.uid
                  && request.resource.data.athleteId is string
                  && request.resource.data.athleteId.size() > 0
                  && request.resource.data.title is string
                  && request.resource.data.title.size() < 200
                  && request.resource.data.meals is list;
      allow update: if request.auth != null
                  && resource.data.trainerId == request.auth.uid
                  && request.resource.data.trainerId == resource.data.trainerId
                  && request.resource.data.athleteId == resource.data.athleteId
                  && request.resource.data.title is string
                  && request.resource.data.title.size() < 200
                  && request.resource.data.meals is list;
      allow delete: if request.auth != null
                  && request.auth.uid == resource.data.trainerId;
    }

    // Payment records created by trainers against athletes (Pagos P1).
    match /payments/{paymentId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.trainerId
                      || request.auth.uid == resource.data.athleteId);
      // rules-hardening Slice C (AD-1 option b) — Coach-Collection Create
      // Requires Trainer Role: closes the "any athlete-role user forges a
      // payment debt naming themselves trainer" vector. Role-check only,
      // NOT a trainer_links relationship check — see design.md AD-1 /
      // engram obs #413.
      // QA-PAY-007 (#447): create now validates the money fields — before
      // this, a legit-role trainer with a modified client could write
      // amountArs negative/zero/decimal/string (poisoning the totals both
      // sides see), unbounded concept, or arbitrary status/periodKey.
      // Calibrated against every real writer: PaymentRepository.add and
      // AppointmentRepository.billAppointment(s) both stamp id == doc id;
      // paidPaymentFor legitimately creates already-paid records (status
      // 'paid' + paidAt); the cita/vencimiento flows legitimately set dueAt
      // at create (REQ-VENC-13 pins it immutable AFTER create, and only the
      // CF may touch lastOverdueNotifiedAt — pinned null here).
      // periodKey: null (porSesión/suelto) | 'YYYY-MM' (mensual) |
      // 'YYYY-Www' (ISO week, semanal) — the two formats
      // pagosPorCobrarProvider computes.
      allow create: if request.auth != null
                  && request.resource.data.trainerId == request.auth.uid
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'
                  && request.resource.data.athleteId is string
                  && request.resource.data.athleteId.size() > 0
                  && request.resource.data.keys().hasOnly([
                       'id', 'trainerId', 'athleteId', 'amountArs', 'concept',
                       'status', 'periodKey', 'createdAt', 'paidAt', 'dueAt',
                       'lastOverdueNotifiedAt'
                     ])
                  && request.resource.data.id == paymentId
                  && request.resource.data.amountArs is int
                  && request.resource.data.amountArs > 0
                  && request.resource.data.amountArs <= 100000000
                  && request.resource.data.concept is string
                  && request.resource.data.concept.size() > 0
                  && request.resource.data.concept.size() <= 200
                  && request.resource.data.status in ['pending', 'paid']
                  && (request.resource.data.get('periodKey', null) == null
                      || (request.resource.data.periodKey is string
                          && request.resource.data.periodKey.matches('^[0-9]{4}-(W[0-9]{2}|[0-9]{2})$')))
                  && request.resource.data.createdAt is timestamp
                  && (request.resource.data.get('paidAt', null) == null
                      || request.resource.data.paidAt is timestamp)
                  && (request.resource.data.get('dueAt', null) == null
                      || request.resource.data.dueAt is timestamp)
                  && request.resource.data.get('lastOverdueNotifiedAt', null) == null;
      // REQ-VENC-13: tightened update rule — field-level protection.
      // Follows the `reviews` rule pattern (keys().hasOnly + per-field equality).
      // Audited: markPaid/markManyPaid send only {status, paidAt} — still pass.
      // dueAt is pinned equal-to-existing so clients cannot set or alter it;
      // the CF bypasses rules via Admin SDK.
      // lastOverdueNotifiedAt is added to hasOnly (future-proof) and pinned so
      // clients cannot write it — the CF writes it via Admin SDK (bypasses rules).
      allow update: if request.auth != null
                  && resource.data.trainerId == request.auth.uid
                  && request.resource.data.keys().hasOnly([
                       'id', 'trainerId', 'athleteId', 'amountArs', 'concept',
                       'status', 'periodKey', 'createdAt', 'paidAt', 'dueAt',
                       'lastOverdueNotifiedAt'
                     ])
                  && request.resource.data.id == resource.data.id
                  && request.resource.data.trainerId == resource.data.trainerId
                  && request.resource.data.athleteId == resource.data.athleteId
                  && request.resource.data.amountArs == resource.data.amountArs
                  && request.resource.data.concept == resource.data.concept
                  && request.resource.data.createdAt == resource.data.createdAt
                  && request.resource.data.get('periodKey', null) == resource.data.get('periodKey', null)
                  && request.resource.data.get('dueAt', null) == resource.data.get('dueAt', null)
                  && request.resource.data.get('lastOverdueNotifiedAt', null) == resource.data.get('lastOverdueNotifiedAt', null);
      allow delete: if request.auth != null && resource.data.trainerId == request.auth.uid;
    }

    // Athlete → trainer reviews (Fase 6 Etapa 7).
    // Doc id is deterministic: `${linkId}_${athleteId}`.
    // REQ-RV-DATA-007. SCENARIO-580..585.
    //
    // rules-hardening Slice B (AD-1) — Review Create Requires Real Trainer
    // Link: `athleteId == auth.uid` + rating bounds alone are NOT sufficient
    // to prove a real coaching relationship — any athlete could otherwise
    // forge a 1-star (sabotage) or 5-star (self-boost-by-proxy) review for
    // ANY trainerId with no relationship at all. The doc-id is pinned to the
    // deterministic `${linkId}_${athleteId}` convention (mirrors
    // Review.idFor), and the named trainer_links/{linkId} document must be a
    // real, non-terminated relationship naming both parties. This is the
    // same cross-doc get()-gate idiom used for role checks elsewhere in this
    // file (e.g. the `gyms` create rule), applied here to a relationship
    // check instead of a role.
    //
    // Rules:
    //   read:   any authenticated user (needed for public profile display).
    //   create: athlete creates their own review (athleteId == auth.uid);
    //           doc-id must equal `${linkId}_${athleteId}`; the named
    //           trainer_links/{linkId} must exist with athleteId/trainerId
    //           matching the review payload and status in [active, paused]
    //           (a terminated link no longer proves a live relationship);
    //           rating must be 1..5; comment ≤500 chars.
    //   update: owner only; may change only rating, comment, updatedAt —
    //           preventing id/linkId/athleteId/trainerId/createdAt tampering.
    //   delete: always denied — only account-deletion CF may delete reviews.
    match /reviews/{reviewId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.athleteId
                    && reviewId == request.resource.data.linkId + '_' + request.resource.data.athleteId
                    && get(/databases/$(database)/documents/trainer_links/$(request.resource.data.linkId)).data.athleteId == request.auth.uid
                    && get(/databases/$(database)/documents/trainer_links/$(request.resource.data.linkId)).data.trainerId == request.resource.data.trainerId
                    && get(/databases/$(database)/documents/trainer_links/$(request.resource.data.linkId)).data.status in ['active', 'paused']
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && (!('comment' in request.resource.data)
                        || request.resource.data.comment == null
                        || request.resource.data.comment.size() <= 500);

      allow update: if request.auth != null
                    && request.auth.uid == resource.data.athleteId
                    && request.resource.data.keys().hasOnly(
                        ['id', 'linkId', 'athleteId', 'trainerId',
                         'rating', 'comment', 'createdAt', 'updatedAt'])
                    && request.resource.data.id == resource.data.id
                    && request.resource.data.linkId == resource.data.linkId
                    && request.resource.data.athleteId == resource.data.athleteId
                    && request.resource.data.trainerId == resource.data.trainerId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && (!('comment' in request.resource.data)
                        || request.resource.data.comment == null
                        || request.resource.data.comment.size() <= 500);

      allow delete: if false;
    }

    // ── mail_queue ──────────────────────────────────────────────────────────
    //
    // Outbox de email transaccional (Resend). Escrito SOLO por `enqueueMail`
    // vía Admin SDK (que saltea estas reglas) y consumido SOLO por la Cloud
    // Function `sendQueuedMail`.
    //
    // Cerrado en los cuatro verbos a propósito. Un cliente que pudiera crear
    // filas acá mandaría mail arbitrario desde el dominio de TREINO — o sea,
    // un relay de spam con nuestra reputación de remitente. Y uno que pudiera
    // leerlas se llevaría las direcciones de email de otros usuarios.
    match /mail_queue/{mailId} {
      allow read, write: if false;
    }
  }
}
