{
  "name": "treino-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for TREINO",
  "scripts": {
    "build": "tsc",
    "serve": "cd .. && bash scripts/emulator.sh",
    "test": "jest --forceExit",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "test:rules": "jest --forceExit --runInBand \"[-]rules\\.test\\.ts$\"",
    "test:rules:emulator": "node ../scripts/strip_rules.js && firebase emulators:exec --only firestore,auth,storage --project treino-rules-test \"npm run test:rules\"",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "@anthropic-ai/vertex-sdk": "0.20.4",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^7.4.0",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "eslint": "^10.13.0",
    "firebase-functions-test": "^3.1.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.72.0"
  },
  "private": true
}
