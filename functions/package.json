{
  "name": "treino-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for TREINO",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions --project treino-dev",
    "test": "jest --forceExit",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "test:rules": "jest --forceExit --runInBand \"[-]rules\\.test\\.ts$\"",
    "test:rules:emulator": "firebase emulators:exec --only firestore,auth,storage --project treino-rules-test \"npm run test:rules\"",
    "lint": "eslint --ext .ts src/",
    "lint:fix": "eslint --ext .ts src/ --fix"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "firebase-functions-test": "^3.1.0",
    "jest": "^30.5.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.4.0"
  },
  "private": true
}
