{
  "name": "treino-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for TREINO",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions --project treino-dev",
    "test": "jest --forceExit",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "test:rules": "jest --forceExit --runInBand \"[-]rules\\.test\\.ts$\"",
    "test:rules:emulator": "firebase emulators:exec --only firestore,auth,storage --project treino-rules-test \"npm run test:rules\"",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "eslint": "^10.12.0",
    "firebase-functions-test": "^3.1.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.71.1"
  },
  "private": true
}
