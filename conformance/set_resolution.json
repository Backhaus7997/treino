            "reps": 10
          },
          {
            "reps": 10
          },
          {
            "reps": 10
          }
        ]
      }
    },
    {
      "name": "varios targetReps: una fila por entrada, targetSets se IGNORA",
      "why": "Una secuencia explicita [6,8,10] describe 3 series aunque targetSets diga 5. El dato mas especifico manda.",
      "given": {
        "week": 0,
        "activeWeeks": [],
        "weeklySets": [],
        "sets": [],
        "targetSets": 5,
        "durationSeconds": null,
        "targetReps": [
          6,
