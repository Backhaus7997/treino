{
  "rule": "set-resolution",
  "source_of_truth": "lib/features/workout/domain/routine_slot.dart (effectiveSetsForWeek / isPresentInWeek)",
  "description": "Que series le tocan al atleta en un ejercicio, para una semana dada. Es la logica mas sutil del dominio y la que mas riesgo de divergencia tiene: define lo que el atleta efectivamente levanta.",
  "inputs": {
    "week": "Semana 0-based del plan.",
    "activeWeeks": "Mascara de PRESENCIA. Vacia = presente en TODAS las semanas (back-compat: los docs legacy no traen el campo).",
    "weeklySets": "Prescripcion por semana. Outer vacio = legacy, resolver por la via plana. Una semana EN RANGO pero vacia es un deload AUTORADO y se devuelve tal cual, sin fallback.",
    "sets": "Filas explicitas. Si hay, ganan sobre todo lo plano.",
    "targetSets": "Cantidad de series del modelo plano. Se clampea a [1, 999]: siempre al menos una.",
    "durationSeconds": "Si es > 0, las series son por tiempo y no por reps.",
    "targetReps": "Reps por serie. Un solo valor = uniforme para targetSets filas. Varios = una fila por entrada, ignorando targetSets.",
    "targetRepsMin/targetRepsMax/targetWeightKg": "Ultimo fallback, como rango. min/max son enteros NO nulos en el modelo; 0 significa 'no aplica' en los casos donde gana otra via."
  },
  "cases": [
    {
      "name": "legacy por rango: targetSets filas identicas",
      "given": {
        "week": 0,
        "activeWeeks": [],
        "weeklySets": [],
        "sets": [],
        "targetSets": 4,
        "durationSeconds": null,
        "targetReps": [],
        "targetRepsMin": 5,
        "targetRepsMax": 6,
        "targetWeightKg": 100
      },
      "expect": {
        "isActive": true,
        "sets": [
          {
            "repsMin": 5,
            "repsMax": 6,
            "weightKg": 100
          },
          {
            "repsMin": 5,
            "repsMax": 6,
            "weightKg": 100
          },
          {
            "repsMin": 5,
            "repsMax": 6,
            "weightKg": 100
          },
          {
            "repsMin": 5,
            "repsMax": 6,
            "weightKg": 100
          }
        ]
      }
    },
    {
      "name": "targetSets 0 igual produce una serie",
      "why": "El clamp a [1,999] evita que un doc mal cargado deje al atleta sin nada que hacer.",
      "given": {
        "week": 0,
        "activeWeeks": [],
        "weeklySets": [],
        "sets": [],
        "targetSets": 0,
        "durationSeconds": null,
        "targetReps": [],
        "targetRepsMin": 8,
        "targetRepsMax": 12,
        "targetWeightKg": null
      },
      "expect": {
        "isActive": true,
        "sets": [
          {
            "repsMin": 8,
            "repsMax": 12,
            "weightKg": null
          }
        ]
      }
    },
    {
      "name": "duracion gana sobre reps",
      "given": {
        "week": 0,
        "activeWeeks": [],
        "weeklySets": [],
        "sets": [],
        "targetSets": 3,
        "durationSeconds": 45,
        "targetReps": [
          10
        ],
        "targetRepsMin": 0,
        "targetRepsMax": 0,
        "targetWeightKg": null
      },
      "expect": {
        "isActive": true,
        "sets": [
          {
            "durationSeconds": 45
          },
          {
            "durationSeconds": 45
          },
          {
            "durationSeconds": 45
          }
        ]
      }
    },
    {
      "name": "un solo targetReps se repite targetSets veces",
      "given": {
